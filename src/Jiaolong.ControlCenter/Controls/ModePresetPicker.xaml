<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.ModePresetPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="PresetRowButtonStyle" TargetType="Button" BasedOn="{StaticResource PrototypeQuickActionStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="PresetIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PrototypeQuickActionStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeSecondaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>
    <Button x:Name="PickerButton" Height="52" HorizontalContentAlignment="Stretch" Style="{StaticResource ControlPresetPickerButtonStyle}" ToolTipService.ToolTip="选择模式与预设" AutomationProperties.AutomationId="PerformancePresetPicker" AutomationProperties.Name="选择模式与预设">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <FontIcon x:Name="SelectionIcon" Glyph="&#xE7F4;" FontSize="19" />
            <TextBlock x:Name="SelectionText" Grid.Column="1" VerticalAlignment="Center" FontSize="16" TextTrimming="CharacterEllipsis" />
            <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="13" />
        </Grid>
        <Button.Flyout>
            <Flyout x:Name="PresetFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnFlyoutOpening" Opened="OnFlyoutOpened" Closing="OnFlyoutClosing" Closed="OnFlyoutClosed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MaxWidth" Value="620" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Border x:Name="PresetSurface" Width="600" Height="390" Padding="22,18" BorderBrush="#38FFFFFF" BorderThickness="0.7" CornerRadius="14">
                    <Border.Background><AcrylicBrush TintColor="#18181B" TintOpacity="0.72" TintLuminosityOpacity="0.30" FallbackColor="#F018181B" /></Border.Background>
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="选择模式与预设" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="6 个模式 · 每个模式 3 个预设" FontSize="13" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.35*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="0.65*" /></Grid.ColumnDefinitions>
                            <StackPanel x:Name="ModeList" Spacing="6">
                                <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource PresetRowButtonStyle}"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="12,3" /></Style></StackPanel.Resources>
                                <Button Tag="Office" Click="OnModeClick" Height="36" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE7F4;" FontSize="18" /><TextBlock Text="办公模式" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Tag="Gaming" Click="OnModeClick" Height="36" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE7FC;" FontSize="18" /><TextBlock Text="游戏模式" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Tag="Turbo" Click="OnModeClick" Height="36" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE945;" FontSize="18" /><TextBlock Text="狂飙模式" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Tag="Custom1" Click="OnModeClick" Height="36" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8A5;" FontSize="18" /><TextBlock Text="自定义 1" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Tag="Custom2" Click="OnModeClick" Height="36" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8A5;" FontSize="18" /><TextBlock Text="自定义 2" VerticalAlignment="Center" /></StackPanel></Button>
                                <Button Tag="Custom3" Click="OnModeClick" Height="36" HorizontalContentAlignment="Stretch"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8A5;" FontSize="18" /><TextBlock Text="自定义 3" VerticalAlignment="Center" /></StackPanel></Button>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#32FFFFFF" />
                            <Grid Grid.Column="2">
                                <StackPanel x:Name="SlotList" Spacing="9">
                                    <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource PresetRowButtonStyle}"><Setter Property="CornerRadius" Value="12" /></Style></StackPanel.Resources>
                                    <Button Tag="1" Click="OnSlotClick" Height="72" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Width="22" Height="22"><Ellipse Stroke="#9FFFFFFF" StrokeThickness="2" /><Ellipse x:Name="Slot1EditingMarker" Width="10" Height="10" Fill="White" Visibility="Collapsed" /></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="预设 1" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="Slot1Summary" FontSize="12" TextTrimming="CharacterEllipsis" Text="85°C · 45W · 4.2GHz" Foreground="{StaticResource PrototypeSecondaryTextBrush}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Vertical" Spacing="3" VerticalAlignment="Center"><Border x:Name="Slot1EditingBadge" Padding="9,4" Background="#C0363A43" CornerRadius="12" Visibility="Collapsed"><TextBlock Text="正在编辑" FontSize="11" Foreground="White" /></Border><Border x:Name="Slot1UsingBadge" Padding="9,4" Background="#C0208A55" CornerRadius="12" Visibility="Collapsed"><TextBlock Text="正在使用" FontSize="11" Foreground="White" /></Border></StackPanel></Grid></Button>
                                    <Button Tag="2" Click="OnSlotClick" Height="72" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Width="22" Height="22"><Ellipse Stroke="#9FFFFFFF" StrokeThickness="2" /><Ellipse x:Name="Slot2EditingMarker" Width="10" Height="10" Fill="White" Visibility="Collapsed" /></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="预设 2" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="Slot2Summary" FontSize="12" TextTrimming="CharacterEllipsis" Text="85°C · 45W · 4.2GHz" Foreground="{StaticResource PrototypeSecondaryTextBrush}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Vertical" Spacing="3" VerticalAlignment="Center"><Border x:Name="Slot2EditingBadge" Padding="9,4" Background="#C0363A43" CornerRadius="12" Visibility="Collapsed"><TextBlock Text="正在编辑" FontSize="11" Foreground="White" /></Border><Border x:Name="Slot2UsingBadge" Padding="9,4" Background="#C0208A55" CornerRadius="12" Visibility="Collapsed"><TextBlock Text="正在使用" FontSize="11" Foreground="White" /></Border></StackPanel></Grid></Button>
                                    <Button Tag="3" Click="OnSlotClick" Height="72" HorizontalContentAlignment="Stretch"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid Width="22" Height="22"><Ellipse Stroke="#9FFFFFFF" StrokeThickness="2" /><Ellipse x:Name="Slot3EditingMarker" Width="10" Height="10" Fill="White" Visibility="Collapsed" /></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="预设 3" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="Slot3Summary" FontSize="12" TextTrimming="CharacterEllipsis" Text="85°C · 45W · 4.2GHz" Foreground="{StaticResource PrototypeSecondaryTextBrush}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Vertical" Spacing="3" VerticalAlignment="Center"><Border x:Name="Slot3EditingBadge" Padding="9,4" Background="#C0363A43" CornerRadius="12" Visibility="Collapsed"><TextBlock Text="正在编辑" FontSize="11" Foreground="White" /></Border><Border x:Name="Slot3UsingBadge" Padding="9,4" Background="#C0208A55" CornerRadius="12" Visibility="Collapsed"><TextBlock Text="正在使用" FontSize="11" Foreground="White" /></Border></StackPanel></Grid></Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
