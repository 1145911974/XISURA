<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.ParameterHelpButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    VerticalAlignment="Center">
    <Button
        x:Name="HelpButton"
        Content="?"
        VerticalAlignment="Center"
        Style="{StaticResource PerformanceInfoButtonStyle}"
        AutomationProperties.Name="查看参数说明">
        <Button.Resources>
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrototypeStrokeBrush" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="PrototypeSecondaryTextBrush" />
        </Button.Resources>
        <ToolTipService.ToolTip>
            <ToolTip Placement="Bottom" Width="340" MaxWidth="340" Padding="16"
                     Background="Transparent"
                     BorderBrush="{StaticResource PrototypeStrokeBrush}"
                     BorderThickness="1" CornerRadius="14">
                <Grid>
                    <!-- Tooltips use a separate popup surface; in-app acrylic cannot sample its background. -->
                    <SystemBackdropElement Margin="-16" CornerRadius="13" IsHitTestVisible="False">
                        <SystemBackdropElement.SystemBackdrop>
                            <DesktopAcrylicBackdrop />
                        </SystemBackdropElement.SystemBackdrop>
                    </SystemBackdropElement>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="ParameterNameText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                            <TextBlock x:Name="EffectText" TextWrapping="Wrap" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock x:Name="CurrentValueText" TextWrapping="Wrap" Foreground="{StaticResource PrototypeTextBrush}" />
                            <TextBlock x:Name="RecommendedRangeText" TextWrapping="Wrap" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock x:Name="SafeRangeText" TextWrapping="Wrap" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock x:Name="ExtremeLimitText" TextWrapping="Wrap" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock x:Name="RiskText" TextWrapping="Wrap" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ToolTip>
        </ToolTipService.ToolTip>
    </Button>
</UserControl>
