<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.PerformanceParameterRowV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Controls"
    Height="102">
    <UserControl.Resources>
        <Color x:Key="PerformanceValueForegroundColor">#FFF8FBFF</Color>
        <Color x:Key="PerformanceValuePlaceholderColor">#B8E5E9F0</Color>
        <Color x:Key="PerformanceValueBackgroundColor">#C20A0E15</Color>
        <Color x:Key="PerformanceValueBorderColor">#42FFFFFF</Color>
        <SolidColorBrush x:Key="PerformanceValueBackgroundBrush" Color="{StaticResource PerformanceValueBackgroundColor}" />
        <SolidColorBrush x:Key="PerformanceValueBorderBrush" Color="{StaticResource PerformanceValueBorderColor}" />
        <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource PerformanceValueForegroundColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource PerformanceValueBackgroundColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource PerformanceValueBorderColor}" />
        <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="{StaticResource PerformanceValuePlaceholderColor}" />
    </UserControl.Resources>
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="157" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="98" />
            <ColumnDefinition x:Name="TrailingColumn" Width="52" />
        </Grid.ColumnDefinitions>

        <ContentPresenter x:Name="IconPresenter" Width="34" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" VerticalAlignment="Center" />
                <controls:ParameterHelpButton x:Name="HelpButton" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="DescriptionText" FontSize="14" Foreground="{StaticResource PrototypeSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <controls:PerformanceTuningRailV2 x:Name="Rail" Grid.Column="2" VerticalAlignment="Center" />

        <TextBox
            x:Name="ValueBox"
            Grid.Column="3"
            Width="98"
            Height="42"
            MinHeight="42"
            CornerRadius="9"
            FontSize="20"
            FontWeight="SemiBold"
            TextAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Padding="0,4,0,0"
            PlaceholderText="—"
            Background="{StaticResource PerformanceValueBackgroundBrush}"
            Foreground="{StaticResource PrototypeTextBrush}"
            BorderBrush="{StaticResource PerformanceValueBorderBrush}"
            BorderThickness="1"
            UseSystemFocusVisuals="True"
            FocusVisualPrimaryBrush="{StaticResource ModeAccentBrush}"
            FocusVisualSecondaryBrush="Transparent"
            TextChanged="OnValueBoxTextChanged"
            LostFocus="OnValueBoxLostFocus" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="UnitText" FontSize="16" Foreground="{StaticResource PrototypeSecondaryTextBrush}" VerticalAlignment="Center" />
            <ContentPresenter x:Name="AccessoryPresenter" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
