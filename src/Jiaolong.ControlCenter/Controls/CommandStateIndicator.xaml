<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.CommandStateIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Bind AccessibleText, Mode=OneWay}">
        <TextBlock Text="●" Foreground="{ThemeResource DataBrush}" />
        <TextBlock Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
        <TextBlock Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>
</UserControl>
