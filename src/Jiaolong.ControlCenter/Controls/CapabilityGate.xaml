<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.CapabilityGate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsEnabled="{x:Bind IsAvailable, Mode=OneWay}">
    <Border Padding="12" Background="{ThemeResource SurfaceRaisedBrush}" CornerRadius="{StaticResource RadiusMedium}">
        <StackPanel Spacing="4">
            <Border IsHitTestVisible="{x:Bind IsAvailable, Mode=OneWay}">
                <ContentPresenter Content="{x:Bind ChildContent, Mode=OneWay}" />
            </Border>
            <TextBlock Text="{x:Bind Reason, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
