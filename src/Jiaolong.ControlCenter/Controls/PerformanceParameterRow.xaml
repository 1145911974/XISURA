<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.PerformanceParameterRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Controls"
    MinHeight="82">
    <UserControl.Resources>
        <Style x:Key="ParameterValueBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="98" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#B20D1118" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="MeasuredSliderStyle" TargetType="Slider">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ModeAccentBrush}" />
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="SliderContainer" Background="Transparent">
                            <Grid x:Name="HorizontalTemplate" MinHeight="44">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle
                                    x:Name="HorizontalTrackRect"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    Height="12"
                                    Fill="#2BFFFFFF"
                                    RadiusX="6"
                                    RadiusY="6" />
                                <Rectangle
                                    x:Name="HorizontalDecreaseRect"
                                    Grid.Row="1"
                                    Height="12"
                                    Fill="{StaticResource ModeMeterGradientBrush}"
                                    RadiusX="6"
                                    RadiusY="6" />
                                <Thumb
                                    x:Name="HorizontalThumb"
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    AutomationProperties.Name="当前值">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="20" Height="20">
                                                <Ellipse Width="20" Height="20" Fill="{StaticResource ModeAccentBrush}" />
                                                <Ellipse Width="8" Height="8" Fill="White" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TrailingColumn" Width="54" />
            <ColumnDefinition Width="164" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="98" />
            <ColumnDefinition Width="54" />
        </Grid.ColumnDefinitions>

        <ContentPresenter
            x:Name="IconPresenter"
            Width="36"
            Height="44"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrototypeTextBrush}"
                    VerticalAlignment="Center" />
                <controls:ParameterHelpButton
                    x:Name="HelpButton"
                    VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="DescriptionText"
                FontSize="12"
                Foreground="{StaticResource PrototypeSecondaryTextBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Column="2" Height="60" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <Canvas Height="44" IsHitTestVisible="False">
                <Ellipse
                    x:Name="CurrentValueGlow"
                    Width="34"
                    Height="34"
                    Canvas.Top="5"
                    Fill="{StaticResource ModeSelectionAccentBrush}" />
            </Canvas>
            <Slider
                x:Name="ValueSlider"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                Style="{StaticResource MeasuredSliderStyle}"
                ValueChanged="OnSliderValueChanged" />
            <Canvas
                x:Name="ScaleOverlay"
                Height="44"
                IsHitTestVisible="False"
                SizeChanged="OnScaleOverlaySizeChanged">
                <Border
                    x:Name="CurrentValueBadge"
                    Canvas.Top="0"
                    Padding="2,0">
                    <TextBlock x:Name="CurrentValueText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Ellipse
                    x:Name="RecommendationMarker"
                    Width="7"
                    Height="7"
                    Canvas.Top="18.5"
                    Fill="#FFF5F7FA"
                    Stroke="#78000000"
                    StrokeThickness="1" />
                <Border
                    x:Name="ControlLimitMarker"
                    Width="3"
                    Height="18"
                    Canvas.Top="13"
                    Background="#FFFF5A6F"
                    CornerRadius="1.5" />
                <TextBlock
                    x:Name="ControlLimitText"
                    Canvas.Top="0"
                    FontSize="11"
                    Foreground="#FFFF7487" />
            </Canvas>
            <Grid Grid.Row="1" IsHitTestVisible="False">
                <TextBlock x:Name="MinimumValueText" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                <TextBlock x:Name="RecommendationValueText" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                <TextBlock x:Name="MaximumValueText" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
            </Grid>
        </Grid>

        <NumberBox
            x:Name="ValueBox"
            Grid.Column="3"
            Style="{StaticResource ParameterValueBoxStyle}"
            ValueChanged="OnNumberBoxValueChanged"
            PointerWheelChanged="OnNumberBoxPointerWheelChanged"
            VerticalAlignment="Center" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock
                x:Name="UnitText"
                FontSize="14"
                Foreground="{StaticResource PrototypeSecondaryTextBrush}"
                VerticalAlignment="Center" />
            <ContentPresenter x:Name="AccessoryPresenter" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
