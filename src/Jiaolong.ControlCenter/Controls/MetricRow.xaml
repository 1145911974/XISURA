<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.MetricRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid AutomationProperties.Name="{x:Bind AccessibleText, Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource TelemetryTextStyle}" />
            <TextBlock Text="{x:Bind Unit, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
