<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.Sparkline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="48" AutomationProperties.Name="{x:Bind Summary, Mode=OneWay}">
        <Canvas x:Name="Plot" />
        <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
