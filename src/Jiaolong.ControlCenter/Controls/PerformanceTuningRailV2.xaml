<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.PerformanceTuningRailV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="66">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="20" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <Canvas x:Name="TopLabels" Grid.Row="0" IsHitTestVisible="False">
            <TextBlock x:Name="CurrentText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
        </Canvas>

        <Grid Grid.Row="1" Height="20">
            <Border Height="6" Margin="16,0" Background="{StaticResource PerformanceV2TrackBrush}" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="3" />
            <Canvas x:Name="RailCanvas" Margin="16,0" IsHitTestVisible="False">
                <Border x:Name="ActiveFill" Height="6" Canvas.Top="7" Background="{StaticResource ModeMeterGradientBrush}" CornerRadius="3" />
                <Border x:Name="RecommendedMarker" Width="2" Height="14" Canvas.Top="3" Background="White" CornerRadius="1" />
                <Ellipse x:Name="CurrentThumb" Width="14" Height="14" Canvas.Top="3" Fill="{StaticResource ModeAccentBrush}" Stroke="#F2FFFFFF" StrokeThickness="1.5" />
                <Ellipse x:Name="CurrentCore" Width="4" Height="4" Canvas.Top="8" Fill="White" />
            </Canvas>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0" IsHitTestVisible="False">
            <TextBlock x:Name="MinimumText" FontSize="14" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
            <TextBlock x:Name="RecommendedText" HorizontalAlignment="Center" FontSize="14" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
            <TextBlock x:Name="MaximumText" HorizontalAlignment="Right" FontSize="14" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
        </Grid>

        <Slider
            x:Name="InputSlider"
            Grid.Row="1"
            Height="20"
            Margin="16,0"
            Background="Transparent"
            Opacity="0.001"
            IsThumbToolTipEnabled="False"
            UseSystemFocusVisuals="False"
            ValueChanged="OnInputValueChanged"
            SizeChanged="OnInputSizeChanged" />
    </Grid>
</UserControl>
