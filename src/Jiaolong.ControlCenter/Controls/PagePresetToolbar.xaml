<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Jiaolong_ControlCenter.Controls.PagePresetToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jiaolong_ControlCenter.Controls">
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="0">
        <Grid Margin="0,0,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="162" /></Grid.ColumnDefinitions>
            <Grid Width="260" Height="52">
                <Grid.RenderTransform><TranslateTransform x:Name="PresetPickerTranslation" X="162" /></Grid.RenderTransform>
                <local:ModePresetPicker x:Name="PresetPicker" Height="52" SelectedKeyChanged="OnSelectedKeyChanged" />
            </Grid>
            <Grid x:Name="PresetStatusHost" Grid.Column="1" Width="148" Height="52" VerticalAlignment="Top" Visibility="Visible" Opacity="0" IsHitTestVisible="False" Background="Transparent" HorizontalAlignment="Right">
                <Grid.RenderTransform><TranslateTransform x:Name="PresetStatusTranslation" /></Grid.RenderTransform>
                <Grid.Clip><RectangleGeometry Rect="0,0,148,52" /></Grid.Clip>
                <Grid Width="148" ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource ModeAccentBrush}" />
                    <TextBlock x:Name="PresetStatusText" Grid.Column="1" Text="有未保存的更改" Foreground="{StaticResource ModeAccentBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="EditingActionsHost" Width="0" Height="52" Opacity="0" IsHitTestVisible="False">
            <Grid.Clip><RectangleGeometry x:Name="EditingActionsClip" Rect="0,0,0,52" /></Grid.Clip>
            <StackPanel Orientation="Horizontal" Spacing="10" Width="254" Margin="0,0,10,0" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Width="112" Height="52" Content="保存预设" CornerRadius="12" Style="{StaticResource PerformanceV2ActionButtonStyle}" Click="OnSaveClick" />
                <Button x:Name="ManageButton" Width="132" Height="52" Content="返回当前电脑" CornerRadius="12" Padding="12,0" Style="{StaticResource PerformanceV2ActionButtonStyle}" Click="OnManageClick" />
            </StackPanel>
        </Grid>
        <Button x:Name="MoreButton" Height="52" Width="52" VerticalAlignment="Top" CornerRadius="12" Style="{StaticResource ControlGlassButtonStyle}" AutomationProperties.Name="更多预设操作" ToolTipService.ToolTip="管理、保存与自动应用设置">
            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE712;" FontSize="18" />
            <Button.Flyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Name="ManagePresetMenuItem" Text="管理预设" Click="OnManageClick" />
                    <MenuFlyoutItem x:Name="SaveCurrentMenuItem" Text="保存当前" Click="OnSaveClick" />
                    <MenuFlyoutItem x:Name="SaveAsButton" Text="另存为预设" Click="OnSaveAsClick" />
                    <MenuFlyoutItem x:Name="UseButton" Text="保存并应用" Click="OnUseClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="FollowPresetButton" Text="随模式应用" Visibility="Collapsed" Click="OnFollowPresetClick" AutomationProperties.Name="随模式自动应用本页预设" ToolTipService.ToolTip="开启后随整机模式自动应用本页配置；关闭后保持当前设置" />
                </MenuFlyout>
            </Button.Flyout>
        </Button>
        </StackPanel>
        <TextBlock x:Name="ContextText" Grid.Row="1" Margin="0,8,4,0" MaxWidth="476" Text="当前电脑 · 手动设置" FontSize="13" Foreground="{StaticResource PrototypeSecondaryTextBrush}" TextTrimming="CharacterEllipsis" TextAlignment="Right" HorizontalAlignment="Right" AutomationProperties.AutomationId="PagePresetContextText" />
    </Grid>
</UserControl>
