<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.CpuOperatingBoundaryV2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="430"
    Height="342">
    <Grid Typography.NumeralAlignment="Tabular">
        <Canvas Width="340" Height="340" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Canvas.Left="20" Canvas.Top="20" Width="300" Height="300" Stroke="#16FFFFFF" StrokeThickness="2" />
            <Ellipse Canvas.Left="35" Canvas.Top="35" Width="270" Height="270" Stroke="#0EFFFFFF" StrokeThickness="1" />
            <Ellipse Canvas.Left="65" Canvas.Top="65" Width="210" Height="210" Stroke="#18FFFFFF" StrokeThickness="1" />

            <!-- Each quadrant is a separate geometry. Runtime data controls the bright arc length. -->
            <Path x:Name="TemperatureBasePath" Stroke="#50FF3156" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="PowerBasePath" Stroke="#509F9F2F" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="VoltageBasePath" Stroke="#58BA43FF" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="FrequencyBasePath" Stroke="#5829C8FF" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <Path x:Name="TemperatureInnerPath" Stroke="#88FF3156" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="PowerInnerPath" Stroke="#889F9F2F" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="VoltageInnerPath" Stroke="#88BA43FF" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path x:Name="FrequencyInnerPath" Stroke="#8829C8FF" StrokeThickness="22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

            <Path x:Name="TemperatureActivePath" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FFFF1747" Offset="0" /><GradientStop Color="#FFFF627B" Offset="1" /></LinearGradientBrush></Path.Stroke></Path>
            <Path x:Name="PowerActivePath" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFB22F" Offset="0" /><GradientStop Color="#FFFF7B1C" Offset="1" /></LinearGradientBrush></Path.Stroke></Path>
            <Path x:Name="VoltageActivePath" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="1,0" EndPoint="0,1"><GradientStop Color="#FFD769FF" Offset="0" /><GradientStop Color="#FF9F3CFF" Offset="1" /></LinearGradientBrush></Path.Stroke></Path>
            <Path x:Name="FrequencyActivePath" StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Stroke><LinearGradientBrush StartPoint="1,1" EndPoint="0,0"><GradientStop Color="#FF23B4FF" Offset="0" /><GradientStop Color="#FF43D6FF" Offset="1" /></LinearGradientBrush></Path.Stroke></Path>

            <Line X1="170" Y1="9" X2="170" Y2="27" Stroke="#6FFFFFFF" StrokeThickness="2" />
            <Line X1="250" Y1="31" X2="241" Y2="47" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="309" Y1="90" X2="293" Y2="99" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="331" Y1="170" X2="313" Y2="170" Stroke="#6FFFFFFF" StrokeThickness="2" />
            <Line X1="309" Y1="250" X2="293" Y2="241" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="250" Y1="309" X2="241" Y2="293" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="170" Y1="331" X2="170" Y2="313" Stroke="#6FFFFFFF" StrokeThickness="2" />
            <Line X1="90" Y1="309" X2="99" Y2="293" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="31" Y1="250" X2="47" Y2="241" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="9" Y1="170" X2="27" Y2="170" Stroke="#6FFFFFFF" StrokeThickness="2" />
            <Line X1="31" Y1="90" X2="47" Y2="99" Stroke="#52FFFFFF" StrokeThickness="2" />
            <Line X1="90" Y1="31" X2="99" Y2="47" Stroke="#52FFFFFF" StrokeThickness="2" />

            <Border Canvas.Left="113" Canvas.Top="113" Width="114" Height="114" Background="#F2080B11" BorderBrush="#7FFFFFFF" BorderThickness="2" CornerRadius="13">
                <Grid>
                    <Border Margin="9" Background="#8A15191F" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="8" />
                    <Grid Margin="18">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Text="CPU" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ChipStatusText" Grid.Row="2" Text="未连接" FontSize="9" Foreground="{StaticResource PrototypeSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Grid>
                </Grid>
            </Border>
            <Line X1="127" Y1="107" X2="127" Y2="113" Stroke="#80FFFFFF" /><Line X1="144" Y1="107" X2="144" Y2="113" Stroke="#80FFFFFF" /><Line X1="161" Y1="107" X2="161" Y2="113" Stroke="#80FFFFFF" /><Line X1="178" Y1="107" X2="178" Y2="113" Stroke="#80FFFFFF" /><Line X1="195" Y1="107" X2="195" Y2="113" Stroke="#80FFFFFF" /><Line X1="212" Y1="107" X2="212" Y2="113" Stroke="#80FFFFFF" />
            <Line X1="127" Y1="227" X2="127" Y2="233" Stroke="#80FFFFFF" /><Line X1="144" Y1="227" X2="144" Y2="233" Stroke="#80FFFFFF" /><Line X1="161" Y1="227" X2="161" Y2="233" Stroke="#80FFFFFF" /><Line X1="178" Y1="227" X2="178" Y2="233" Stroke="#80FFFFFF" /><Line X1="195" Y1="227" X2="195" Y2="233" Stroke="#80FFFFFF" /><Line X1="212" Y1="227" X2="212" Y2="233" Stroke="#80FFFFFF" />
        </Canvas>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="2">
            <TextBlock x:Name="TemperatureText" Height="40" LineHeight="40" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" Text="-- °C" FontSize="30" FontWeight="SemiBold" Foreground="#FFFF3156" />
            <TextBlock Text="CPU 温度" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
            <TextBlock x:Name="TemperatureLimitText" Text="上限不可用" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
            <TextBlock x:Name="PowerText" Height="40" LineHeight="40" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" Text="-- W" FontSize="30" FontWeight="SemiBold" Foreground="#FFFF9F2F" HorizontalAlignment="Right" />
            <TextBlock Text="封装功耗" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" HorizontalAlignment="Right" />
            <TextBlock x:Name="PowerLimitText" Text="上限不可用" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" HorizontalAlignment="Right" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="2">
            <TextBlock x:Name="FrequencyText" Height="40" LineHeight="40" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" Text="-- GHz" FontSize="28" FontWeight="SemiBold" Foreground="#FF29C8FF" />
            <TextBlock Text="核心频率（平滑）" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
            <TextBlock x:Name="FrequencyLimitText" Text="上限不可用" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="2">
            <TextBlock x:Name="VoltageText" Height="40" LineHeight="40" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" Text="-- V" FontSize="28" FontWeight="SemiBold" Foreground="#FFBA43FF" HorizontalAlignment="Right" />
            <TextBlock Text="核心电压" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" HorizontalAlignment="Right" />
            <TextBlock x:Name="VoltageLimitText" Text="上限不可用" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</UserControl>
