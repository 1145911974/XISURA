<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.TelemetryGroup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource SurfaceBrush}" Padding="16" CornerRadius="{StaticResource RadiusMedium}">
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind Header, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
            <ContentPresenter Content="{x:Bind GroupContent, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
