<UserControl
    x:Class="Jiaolong_ControlCenter.Controls.FanCurveEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10" AutomationProperties.Name="六点风扇温度曲线">
        <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="12,10">
            <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="温度 / 目标百分比" Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
                    <TextBlock Text="六点阶梯 · 模拟预览" HorizontalAlignment="Right" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                </Grid>
                <Viewbox Height="76" Stretch="Fill" HorizontalAlignment="Stretch">
                    <Canvas Width="500" Height="76">
                        <Line X1="0" Y1="16" X2="500" Y2="16" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.6" StrokeDashArray="4,4" />
                        <Line X1="0" Y1="42" X2="500" Y2="42" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.6" StrokeDashArray="4,4" />
                        <Line X1="0" Y1="68" X2="500" Y2="68" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.6" StrokeDashArray="4,4" />
                        <Line X1="450" Y1="0" X2="450" Y2="76" Stroke="#FFFF7080" StrokeThickness="1.5" StrokeDashArray="3,3" />
                        <Path Data="M 20,65 C 60,63 90,61 110,58 S 190,52 215,47 S 290,38 320,32 S 390,21 420,13 S 450,8 480,5" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3" Fill="Transparent" />
                        <Ellipse Width="8" Height="8" Canvas.Left="16" Canvas.Top="61" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Canvas.Left="106" Canvas.Top="54" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Canvas.Left="211" Canvas.Top="43" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Canvas.Left="316" Canvas.Top="28" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Canvas.Left="416" Canvas.Top="9" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="2" />
                        <Ellipse Width="8" Height="8" Canvas.Left="476" Canvas.Top="1" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="2" />
                    </Canvas>
                </Viewbox>
            </StackPanel>
        </Border>
        <Grid ColumnSpacing="8" RowSpacing="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
            <NumberBox Grid.Row="0" Grid.Column="0" Value="40" Minimum="0" Maximum="120" SpinButtonPlacementMode="Inline" Header="点 1 温度" />
            <NumberBox Grid.Row="0" Grid.Column="1" Value="20" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Header="点 1 目标" />
            <NumberBox Grid.Row="1" Grid.Column="0" Value="50" Minimum="0" Maximum="120" SpinButtonPlacementMode="Inline" Header="点 2 温度" />
            <NumberBox Grid.Row="1" Grid.Column="1" Value="30" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Header="点 2 目标" />
            <NumberBox Grid.Row="2" Grid.Column="0" Value="60" Minimum="0" Maximum="120" SpinButtonPlacementMode="Inline" Header="点 3 温度" />
            <NumberBox Grid.Row="2" Grid.Column="1" Value="40" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Header="点 3 目标" />
            <NumberBox Grid.Row="3" Grid.Column="0" Value="70" Minimum="0" Maximum="120" SpinButtonPlacementMode="Inline" Header="点 4 温度" />
            <NumberBox Grid.Row="3" Grid.Column="1" Value="55" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Header="点 4 目标" />
            <NumberBox Grid.Row="4" Grid.Column="0" Value="80" Minimum="0" Maximum="120" SpinButtonPlacementMode="Inline" Header="点 5 温度" />
            <NumberBox Grid.Row="4" Grid.Column="1" Value="75" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Header="点 5 目标" />
            <NumberBox Grid.Row="5" Grid.Column="0" Value="90" Minimum="0" Maximum="120" SpinButtonPlacementMode="Inline" Header="点 6 温度" />
            <NumberBox Grid.Row="5" Grid.Column="1" Value="100" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" Header="点 6 目标" />
        </Grid>
    </StackPanel>
</UserControl>
