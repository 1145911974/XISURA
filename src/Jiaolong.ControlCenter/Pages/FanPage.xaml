<Page
    x:Class="Jiaolong_ControlCenter.Pages.FanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Controls">
    <Grid Padding="24" Background="{ThemeResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="16" MaxWidth="1100">
                <TextBlock Text="双风扇" Style="{StaticResource DisplayTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CPU RPM  未知" Style="{StaticResource TelemetryTextStyle}" />
                    <TextBlock Grid.Column="1" Text="GPU RPM  未知" Style="{StaticResource TelemetryTextStyle}" />
                    <TextBlock Grid.Column="2" Text="控制权  EC 自动" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Grid.Column="3" Text="健康  未知" Style="{StaticResource SecondaryTextStyle}" />
                </Grid>
                <Button Content="释放为 EC 自动控制" Click="OnReleaseClick" Style="{StaticResource QuietButtonStyle}" AutomationProperties.Name="释放为 EC 自动控制" />
                <RadioButtons Header="控制模式">
                    <RadioButton Content="EC 自动" />
                    <RadioButton Content="官方预设" />
                    <RadioButton Content="固定目标" />
                    <RadioButton Content="温度曲线" />
                </RadioButtons>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="CPU 风扇曲线" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:FanCurveEditor />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="GPU 风扇曲线" Style="{StaticResource SecondaryTextStyle}" />
                        <controls:FanCurveEditor />
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="预览" Click="OnPreviewClick" Style="{StaticResource QuietButtonStyle}" />
                    <Button Content="应用风扇控制" Click="OnApplyClick" Style="{StaticResource QuietButtonStyle}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="等待硬件回读" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
