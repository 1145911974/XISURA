<Page
    x:Class="Jiaolong_ControlCenter.Pages.AutomationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" Background="{ThemeResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="16" MaxWidth="980">
                <TextBlock Text="自适应模式" Style="{StaticResource DisplayTextStyle}" />
                <ToggleSwitch Header="启用自适应" AutomationProperties.Name="启用自适应" OffContent="关闭" OnContent="开启" />
                <RadioButtons Header="电源状态">
                    <RadioButton Content="接通 AC" />
                    <RadioButton Content="电池 DC" />
                </RadioButtons>
                <ToggleSwitch Header="锁屏时安静模式" OffContent="关闭" OnContent="开启" />
                <Expander Header="前台应用 allowlist（不可信 advisory）" IsExpanded="False">
                    <StackPanel Spacing="8">
                        <TextBlock Text="仅保存规范化 basename 和 SHA-256，不保存完整路径或命令行。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="前台应用触发暂不可用" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Expander>
                <Expander Header="阈值与滞回" IsExpanded="False">
                    <StackPanel Spacing="8">
                        <Slider Header="GPU 温度阈值" Minimum="40" Maximum="100" Value="80" />
                        <Slider Header="冷却时间（秒）" Minimum="0" Maximum="600" Value="30" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="当前仲裁顺序" Style="{StaticResource SecondaryTextStyle}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="1. thermal" AutomationProperties.Name="thermal" />
                    <TextBlock Text="2. compatibilityOrConflict" />
                    <TextBlock Text="3. dc" />
                    <TextBlock Text="4. sessionLock" />
                    <TextBlock Text="5. manualOverride" />
                    <TextBlock Text="6. foregroundApp" />
                    <TextBlock Text="7. adaptiveLoad" />
                    <TextBlock Text="8. baseline" AutomationProperties.Name="baseline" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="前台应用触发暂不可用" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
