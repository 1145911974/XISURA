<Page
    x:Class="Jiaolong_ControlCenter.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Controls"
    x:Name="RootPage">
    <Grid Padding="24" Background="{ThemeResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
            <Grid MinHeight="520">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36*" />
                    <ColumnDefinition Width="64*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Padding="8,24,32,24" Spacing="16" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/Brand/JiaolongMark.svg" Width="180" Height="180" Stretch="Uniform" AutomationProperties.Name="蛟龙标志" />
                    <TextBlock Text="蛟龙 16 Pro · MRID6-23" Style="{StaticResource DisplayTextStyle}" TextWrapping="Wrap" />
                    <controls:CommandStateIndicator
                        State="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}"
                        Details="只读监控"
                        AccessibleText="{x:Bind ViewModel.ConnectionStateText, Mode=OneWay}" />
                    <TextBlock Text="当前 BIOS 未验证，仅提供只读监控" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Column="1" RowSpacing="12" ColumnSpacing="12">
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <controls:TelemetryGroup Grid.Row="0" Grid.Column="0" Header="CPU">
                        <controls:TelemetryGroup.GroupContent>
                            <StackPanel Spacing="8">
                                <controls:MetricRow Label="温度" Value="{x:Bind ViewModel.CpuTemperature.Value, Mode=OneWay}" Unit="°C" AccessibleText="{x:Bind ViewModel.CpuTemperature.AccessibleText, Mode=OneWay}" />
                                <controls:MetricRow Label="负载" Value="未知" Unit="%" AccessibleText="CPU 负载未知" />
                                <controls:MetricRow Label="频率" Value="未知" Unit="MHz" AccessibleText="CPU 频率未知" />
                                <controls:MetricRow Label="功耗" Value="未知" Unit="W" AccessibleText="CPU 功耗未知" />
                                <controls:Sparkline Values="{x:Bind ViewModel.CpuTrend, Mode=OneWay}" Summary="60 秒趋势：数据暂不可用" />
                            </StackPanel>
                        </controls:TelemetryGroup.GroupContent>
                    </controls:TelemetryGroup>
                    <controls:TelemetryGroup Grid.Row="0" Grid.Column="1" Header="GPU">
                        <controls:TelemetryGroup.GroupContent>
                            <StackPanel Spacing="8">
                                <controls:MetricRow Label="温度" Value="{x:Bind ViewModel.GpuTemperature.Value, Mode=OneWay}" Unit="°C" AccessibleText="{x:Bind ViewModel.GpuTemperature.AccessibleText, Mode=OneWay}" />
                                <controls:MetricRow Label="负载" Value="未知" Unit="%" AccessibleText="GPU 负载未知" />
                                <controls:MetricRow Label="频率" Value="未知" Unit="MHz" AccessibleText="GPU 频率未知" />
                                <controls:MetricRow Label="功耗" Value="未知" Unit="W" AccessibleText="GPU 功耗未知" />
                            </StackPanel>
                        </controls:TelemetryGroup.GroupContent>
                    </controls:TelemetryGroup>
                    <controls:TelemetryGroup Grid.Row="1" Grid.Column="0" Header="内存 · 磁盘 · 电池">
                        <controls:TelemetryGroup.GroupContent>
                            <StackPanel Spacing="8">
                                <controls:MetricRow Label="内存" Value="未知" Unit="GB" AccessibleText="内存未知" />
                                <controls:MetricRow Label="磁盘" Value="未知" Unit="%" AccessibleText="磁盘使用率未知" />
                                <controls:MetricRow Label="电池" Value="未知" Unit="%" AccessibleText="电池未知" />
                                <controls:MetricRow Label="网络" Value="未知" Unit="" AccessibleText="网络状态未知" />
                            </StackPanel>
                        </controls:TelemetryGroup.GroupContent>
                    </controls:TelemetryGroup>
                    <controls:TelemetryGroup Grid.Row="1" Grid.Column="1" Header="双风扇">
                        <controls:TelemetryGroup.GroupContent>
                            <StackPanel Spacing="8">
                                <controls:MetricRow Label="CPU 风扇" Value="未知" Unit="RPM" AccessibleText="CPU 风扇转速未知" />
                                <controls:MetricRow Label="GPU 风扇" Value="未知" Unit="RPM" AccessibleText="GPU 风扇转速未知" />
                                <controls:MetricRow Label="控制权" Value="只读" Unit="" AccessibleText="风扇控制权只读" />
                                <controls:MetricRow Label="健康" Value="未知" Unit="" AccessibleText="风扇健康状态未知" />
                            </StackPanel>
                        </controls:TelemetryGroup.GroupContent>
                    </controls:TelemetryGroup>
                </Grid>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="8,16,8,0">
            <TextBlock Text="性能模式" Style="{StaticResource SecondaryTextStyle}" />
            <controls:CapabilityGate IsAvailable="{x:Bind ViewModel.IsWriteEnabled, Mode=OneWay}" Reason="{x:Bind ViewModel.WriteDisabledReason, Mode=OneWay}">
                <controls:CapabilityGate.ChildContent>
                    <controls:ModeRail />
                </controls:CapabilityGate.ChildContent>
            </controls:CapabilityGate>
        </StackPanel>
    </Grid>
</Page>
