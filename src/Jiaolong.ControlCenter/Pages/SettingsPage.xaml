<Page
    x:Class="Jiaolong_ControlCenter.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" Background="{ThemeResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="18" MaxWidth="980">
                <TextBlock Text="设置" Style="{StaticResource DisplayTextStyle}" />

                <TextBlock Text="应用行为" Style="{StaticResource SecondaryTextStyle}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="StartupToggle" Header="开机启动" OffContent="关闭" OnContent="开启" Toggled="OnStartupToggled" />
                    <ComboBox x:Name="ThemeComboBox" Header="主题" SelectedIndex="0" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="设备兼容" Style="{StaticResource SecondaryTextStyle}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <TextBlock Text="硬件指纹：未知" />
                    <TextBlock Text="BIOS：未知" />
                    <TextBlock Text="Manifest：未知" />
                    <TextBlock Text="SafeMode：能力证据不足；保持只读" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="官方依赖" Style="{StaticResource SecondaryTextStyle}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <TextBlock Text="服务：JiaolongControlService" />
                    <TextBlock Text="驱动：未知" />
                    <TextBlock Text="安装版本：未知；允许范围：未知" />
                    <TextBlock Text="签名状态：未知" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <TextBlock Text="服务健康" Style="{StaticResource SecondaryTextStyle}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <TextBlock Text="状态：未知" />
                    <TextBlock Text="运行时长：未知；熔断：未知" />
                    <TextBlock Text="最近恢复：未知" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>

                <TextBlock Text="诊断" Style="{StaticResource SecondaryTextStyle}" FontSize="20" FontWeight="SemiBold" />
                <StackPanel Spacing="10">
                    <Button Content="导出诊断包" AutomationProperties.Name="导出诊断包" Click="OnExportDiagnosticsClick" />
                    <Button Content="查看修复说明" AutomationProperties.Name="查看修复说明" Click="OnRepairNotesClick" />
                    <Expander x:Name="RepairExpander" Header="修复说明" IsExpanded="False">
                        <StackPanel Spacing="8" Padding="0,8,0,0">
                            <TextBlock Text="查看当前程序安装目录中的程序与依赖文件。" TextWrapping="Wrap" />
                            <Button Content="打开程序与依赖文件目录" Click="OnOpenInstallerFolderClick" />
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
