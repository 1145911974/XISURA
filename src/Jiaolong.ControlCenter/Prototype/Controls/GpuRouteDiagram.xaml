<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Jiaolong_ControlCenter.Prototype.Controls.GpuRouteDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="763" Height="286">
        <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1.5" CornerRadius="16">
            <Grid Padding="18" ColumnSpacing="11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="49" />
                        <RowDefinition Height="49" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button x:Name="HybridButton" Grid.Row="0" Click="OnHybridClick"
                            FontSize="16" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="8"
                            Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#526A7884" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M 2,4 L 13,4 L 13,12 L 2,12 Z M 8,8 L 19,8 L 19,16 L 8,16 Z"
                                  Width="20" Height="20" Stretch="Uniform" Stroke="#FFE7EAED" StrokeThickness="1.6" />
                            <TextBlock Text="混合输出" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiscreteButton" Grid.Row="1" Click="OnDiscreteClick"
                            FontSize="16" FontWeight="SemiBold"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" CornerRadius="8"
                            Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#526A7884" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Canvas Width="20" Height="20">
                                <Border Canvas.Left="1" Canvas.Top="2" Width="18" Height="12" CornerRadius="1.5" BorderBrush="#FFF5F7F9" BorderThickness="2" Background="Transparent" />
                                <Rectangle Canvas.Left="9" Canvas.Top="14" Width="2" Height="3" Fill="#FFF5F7F9" />
                                <Border Canvas.Left="5" Canvas.Top="17" Width="10" Height="2" CornerRadius="1" Background="#FFF5F7F9" />
                            </Canvas>
                            <TextBlock Text="独显直连" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="11,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="当前生效模式" FontSize="11" Opacity="0.84" />
                            <TextBlock x:Name="CurrentModeText" Text="读取中" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                        <Rectangle Grid.Row="1" Margin="11,0" Fill="{StaticResource PrototypeDividerBrush}" />
                        <StackPanel Grid.Row="2" Margin="11,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="已设置模式" FontSize="11" Opacity="0.84" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="ConfiguredModeText" Text="读取中" FontSize="16" FontWeight="Bold" />
                                <TextBlock x:Name="PendingRestartText" Text="待重启" FontSize="10" Foreground="#FFFF914D"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Rectangle Grid.Column="1" Fill="{StaticResource PrototypeDividerBrush}" Margin="0,0,0,0" />
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="105" />
                        <RowDefinition Height="11" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Canvas x:Name="ActiveDisplaysHost" Grid.Row="0" Width="544" Height="105" Margin="3,0,0,0" Opacity="0" HorizontalAlignment="Left">
                        <Canvas.Clip><RectangleGeometry Rect="0,0,544,105" /></Canvas.Clip>
                        <Canvas.RenderTransform><TranslateTransform x:Name="DisplaysTranslate" /></Canvas.RenderTransform>
                    </Canvas>
                    <Rectangle Grid.Row="1" Width="544" Height="1" Margin="3,0,0,0" Fill="{StaticResource PrototypeDividerBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Border Grid.Row="2" Width="544" Margin="3,0,0,0" HorizontalAlignment="Left" CornerRadius="10">
                        <Canvas x:Name="TopologyHost" Width="541" Height="131" Opacity="0">
                            <Canvas.RenderTransform><TranslateTransform x:Name="TopologyTranslate" /></Canvas.RenderTransform>
                        </Canvas>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
