<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="using:Jiaolong_ControlCenter.Prototype.Controls" xmlns:shared="using:Jiaolong_ControlCenter.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Jiaolong_ControlCenter.Prototype.Controls.FanWorkspaceV2">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <Grid RowSpacing="16" Padding="18,30,18,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="126" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="风扇" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                    <TextBlock Text="调节双风扇转速与温度响应曲线" FontSize="14" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                </StackPanel>
                <shared:PagePresetToolbar x:Name="PresetToolbar" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="风扇总览" FontSize="22" FontWeight="SemiBold" />
                        <shared:ParameterHelpButton x:Name="OverviewHelp" ParameterName="风扇总览" />
                        <TextBlock Text="实时转速与温度" VerticalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                    </StackPanel>
                    <Grid Grid.Row="1" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" ColumnSpacing="18" Padding="12,0" Width="530" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <local:FanAssembly x:Name="CpuFan" Width="188" Height="188" AccentColor="#FFFF244F" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="CPU 风扇" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="CpuRpmText" Text="-- RPM" FontSize="27" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="CpuTemperatureText" Text="-- °C" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="12">
                                <TextBlock Text="RPM" FontSize="11" />
                                <Grid Width="74" Height="139">
                                    <Border Width="24" Height="125" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="10" Background="#FF111318" BorderBrush="#FF747980" BorderThickness="1" Padding="2">
                                        <Grid>
                                            <Border x:Name="CpuSpeedFill" Height="0" VerticalAlignment="Bottom" CornerRadius="7" Background="#FFFF244F" />
                                        </Grid>
                                    </Border>
                                    <Canvas>
                                        <Line X1="30" X2="36" Y1="7" Y2="7" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="7000" Canvas.Left="42" Canvas.Top="0" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="32" Y2="32" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="5600" Canvas.Left="42" Canvas.Top="25" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="57" Y2="57" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="4200" Canvas.Left="42" Canvas.Top="50" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="82" Y2="82" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="2800" Canvas.Left="42" Canvas.Top="75" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="107" Y2="107" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="1400" Canvas.Left="42" Canvas.Top="100" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="132" Y2="132" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="0" Canvas.Left="42" Canvas.Top="125" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="1" ColumnSpacing="18" Padding="12,0" Width="530" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="188" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <local:FanAssembly x:Name="GpuFan" Width="188" Height="188" AccentColor="#FF00D4FF" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Text="GPU 风扇" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="GpuRpmText" Text="-- RPM" FontSize="27" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                <TextBlock x:Name="GpuTemperatureText" Text="-- °C" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="12">
                                <TextBlock Text="RPM" FontSize="11" />
                                <Grid Width="74" Height="139">
                                    <Border Width="24" Height="125" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="10" Background="#FF111318" BorderBrush="#FF747980" BorderThickness="1" Padding="2">
                                        <Grid>
                                            <Border x:Name="GpuSpeedFill" Height="0" VerticalAlignment="Bottom" CornerRadius="7" Background="#FF00D4FF" />
                                        </Grid>
                                    </Border>
                                    <Canvas>
                                        <Line X1="30" X2="36" Y1="7" Y2="7" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="7000" Canvas.Left="42" Canvas.Top="0" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="32" Y2="32" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="5600" Canvas.Left="42" Canvas.Top="25" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="57" Y2="57" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="4200" Canvas.Left="42" Canvas.Top="50" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="82" Y2="82" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="2800" Canvas.Left="42" Canvas.Top="75" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="107" Y2="107" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="1400" Canvas.Left="42" Canvas.Top="100" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                        <Line X1="30" X2="36" Y1="132" Y2="132" Stroke="#FF90949A" StrokeThickness="1" />
                                        <TextBlock Text="0" Canvas.Left="42" Canvas.Top="125" FontSize="10" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                                    </Canvas>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Rectangle Grid.ColumnSpan="2" Width="1" Margin="0,14" Fill="{StaticResource PrototypeDividerBrush}" HorizontalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="2" ColumnSpacing="16" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="312" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <local:FanCurveWorkspaceV2 x:Name="FanCurveWorkspace" VerticalAlignment="Stretch" />
                    <Border x:Name="LiveFanUnknownPanel" Visibility="Collapsed" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                        <TextBlock x:Name="LiveFanUnknownText" Text="当前由 EC 自动控制，固件曲线无法读取。&#xA;选择“温度曲线”后，可从推荐曲线开始设置。" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" />
                    </Border>
                </Grid>
                <Border Grid.Column="1" VerticalAlignment="Stretch" MinHeight="520" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="控制策略" FontSize="22" FontWeight="SemiBold" />
                            <shared:ParameterHelpButton x:Name="StrategyHelp" ParameterName="控制策略" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <RadioButton x:Name="AutoStrategy" Content="EC 自动" GroupName="FanStrategy" Tag="Auto" Checked="OnStrategyChanged" />
                                <StackPanel x:Name="AutomaticCeilingPanel" Margin="28,0,0,0" Spacing="8">
                                    <ToggleSwitch x:Name="MaximumRpmToggle" Header="最大目标转速" Toggled="OnMaximumRpmChanged" AutomationProperties.Name="限制 EC 自动目标转速" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="目标" VerticalAlignment="Center" FontSize="12" />
                                        <shared:GpuValueStepper x:Name="MaximumRpmTarget" Width="122" Minimum="1800" Maximum="5800" Value="5800" SmallChange="100" IsEnabled="False" ValueChanged="OnMaximumRpmValueChanged" AutomationProperties.Name="EC 自动最大目标转速" />
                                        <TextBlock Text="RPM" VerticalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <RadioButton x:Name="FixedStrategy" Content="固定转速" GroupName="FanStrategy" Tag="Fixed" Checked="OnStrategyChanged" />
                                <Grid x:Name="FixedTargetPanel" Margin="28,0,0,0" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="114" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="FixedTargetSlider" Grid.ColumnSpan="3" Minimum="1800" Maximum="5800" Value="3000" StepFrequency="100" IsEnabled="False" ValueChanged="OnFixedSliderChanged" VerticalAlignment="Center">
                                        <Slider.Resources><x:Double x:Key="SliderTrackThemeHeight">8</x:Double></Slider.Resources>
                                    </Slider>
                                    <TextBlock Grid.Row="1" Text="目标" VerticalAlignment="Center" FontSize="12" />
                                    <shared:GpuValueStepper x:Name="FixedTarget" Grid.Row="1" Grid.Column="1" Minimum="1800" Maximum="5800" Value="3000" SmallChange="100" IsEnabled="False" ValueChanged="OnFixedValueChanged" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="RPM" VerticalAlignment="Center" FontSize="11" />
                                </Grid>
                            </StackPanel>
                            <RadioButton x:Name="CurveStrategy" Content="温度曲线" GroupName="FanStrategy" IsChecked="True" Tag="Curve" Checked="OnStrategyChanged" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="{StaticResource PrototypeDividerBrush}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="即时散热" FontWeight="SemiBold" FontSize="15" />
                            <ToggleButton x:Name="StrongCoolingButton" Content="强冷" Style="{StaticResource ControlGlassToggleStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Checked="OnStrongCoolingChanged" Unchecked="OnStrongCoolingChanged" AutomationProperties.Name="强冷" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
