<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Prototype.Controls.PerformanceWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Prototype.Controls"
    xmlns:shared="using:Jiaolong_ControlCenter.Controls"
    Width="1380"
    Height="1045">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TemperatureStatusNormalTextBrush" Color="#FF12E681" />
        <SolidColorBrush x:Key="TemperatureStatusDangerTextBrush" Color="#FFFF5A6F" />
        <Style x:Key="PerformanceSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeSecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
<VisualState.Setters>
<Setter Target="SegmentRoot.BorderBrush" Value="{StaticResource PrototypeTextBrush}" />
</VisualState.Setters>
</VisualState>
                                <VisualState x:Name="Pressed">
<VisualState.Setters>
<Setter Target="SegmentRoot.Background" Value="{StaticResource ModeAccentBrush}" />
</VisualState.Setters>
</VisualState>
                                <VisualState x:Name="Disabled">
<VisualState.Setters>
<Setter Target="SegmentRoot.Opacity" Value="0.45" />
</VisualState.Setters>
</VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PerformanceAdvancedNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PerformanceAdvancedFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PerformanceAdvancedSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="PerformanceMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PerformanceActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ModeAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PerformanceParameterRowStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="78" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PerformanceWorkspaceRoot" Padding="44,112,44,36" RowSpacing="14">
        <Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="*" />
</Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
<ColumnDefinition Width="*" />
<ColumnDefinition Width="Auto" />
</Grid.ColumnDefinitions>
            <StackPanel Spacing="5" VerticalAlignment="Center">
<TextBlock Text="性能控制" Foreground="{StaticResource PrototypeTextBrush}" FontSize="31" FontWeight="SemiBold" />
<TextBlock Text="精确调校 CPU 性能，平衡性能、温度与功耗" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" />
</StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <shared:ModePresetPicker x:Name="ModePresetPickerControl" Width="218" />
                <StackPanel x:Name="UnsavedChangesIndicator" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" MinWidth="118" Visibility="Collapsed">
<Ellipse Width="10" Height="10" Fill="{StaticResource ModeAccentBrush}" VerticalAlignment="Center" />
<TextBlock x:Name="UnsavedChangesText" Text="有未应用的更改" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" VerticalAlignment="Center" />
</StackPanel>
                <TextBlock x:Name="PresetFeedbackText" Width="92" Text="" Foreground="{StaticResource TemperatureStatusNormalTextBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button x:Name="SavePresetButton" Style="{StaticResource PerformanceActionButtonStyle}" Content="保存预设" Click="OnSavePresetClick" AutomationProperties.Name="保存当前性能预设" />
                <Button x:Name="UsePresetButton" Style="{StaticResource PerformanceActionButtonStyle}" Content="使用预设" Click="OnUsePresetClick" AutomationProperties.Name="使用当前性能预设" Background="{StaticResource ModeSelectionBrush}" BorderBrush="{StaticResource ModeAccentBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PerformanceContentScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollMode="Enabled" PointerPressed="OnPerformanceContentPointerPressed">
                <Grid x:Name="PerformancePageContent" ColumnSpacing="14" RowSpacing="14">
                    <Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
<ColumnDefinition Width="1.52*" />
<ColumnDefinition Width="1*" />
</Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="18" Padding="18,16">
                        <ContentControl x:Name="PerformanceControlsPanel" HorizontalContentAlignment="Stretch">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*" />
<ColumnDefinition Width="Auto" />
</Grid.ColumnDefinitions>
<TextBlock Text="基础调校" Foreground="{StaticResource PrototypeTextBrush}" FontSize="20" FontWeight="SemiBold" />
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
<StackPanel Orientation="Horizontal" Spacing="7">
<Ellipse Width="10" Height="10" Fill="{StaticResource ModeAccentBrush}" />
<TextBlock Text="当前值" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="7">
<Ellipse Width="10" Height="10" Fill="{StaticResource PrototypeTextBrush}" />
<TextBlock Text="推荐值" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="7">
<Ellipse Width="10" Height="10" Fill="{StaticResource PrototypeTrackBrush}" />
<TextBlock Text="安全范围" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
</StackPanel>
</StackPanel>
</Grid>

                                <Border Grid.Row="1" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <shared:PerformanceParameterRow
                                        x:Name="TemperatureParameterRow"
                                        Title="温度墙"
                                        Description="CPU 最高温度限制"
                                        Minimum="45"
                                        Maximum="100"
                                        Value="75"
                                        StepFrequency="1"
                                        RecommendedValue="75"
                                        ControlLimitValue="100"
                                        Unit="°C"
                                        HelpEffect="限制处理器最高温度；降低后通常更安静，但持续性能可能下降。"
                                        HelpRecommendedRange="优先保留厂商当前值；内置办公标准档 75°C 仅作软件参考。"
                                        HelpSafeRange="保持已验证温限，需降温时逐步下调；旧界面输入 45–100°C。"
                                        HelpExtremeLimit="100°C 仅是旧界面输入上限，不是安全保证。"
                                        HelpRisk="过低会限制持续性能；过高会增加温度与噪声。"
                                        ValueChanged="OnTemperatureValueChanged"
                                        AutomationProperties.Name="CPU 温度墙参数行">
                                        <shared:PerformanceParameterRow.IconContent>
                                            <Viewbox Width="30" Height="42">
                                                <Canvas Width="24" Height="46">
                                                    <Path
                                                        Data="M12,2 C8.7,2 6,4.7 6,8 L6,25 C3.5,27 2,30.2 2,33.5 C2,39.3 6.5,44 12,44 C17.5,44 22,39.3 22,33.5 C22,30.2 20.5,27 18,25 L18,8 C18,4.7 15.3,2 12,2 Z"
                                                        Fill="Transparent"
                                                        Stroke="{StaticResource PrototypeTextBrush}"
                                                        StrokeLineJoin="Round"
                                                        StrokeThickness="2.5" />
                                                    <Path
                                                        Data="M12,11 L12,34"
                                                        Stroke="{StaticResource PrototypeTextBrush}"
                                                        StrokeEndLineCap="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="4" />
                                                    <Ellipse
                                                        Canvas.Left="6"
                                                        Canvas.Top="28"
                                                        Width="12"
                                                        Height="12"
                                                        Fill="{StaticResource PrototypeTextBrush}" />
                                                </Canvas>
                                            </Viewbox>
                                        </shared:PerformanceParameterRow.IconContent>
                                        <shared:PerformanceParameterRow.AccessoryContent>
                                            <Button Content="确认写入" Style="{StaticResource PerformanceSegmentButtonStyle}" Click="OnApplyTemperatureLimitClick" AutomationProperties.Name="确认写入CPU温度墙" />
                                        </shared:PerformanceParameterRow.AccessoryContent>
                                    </shared:PerformanceParameterRow>
                                </Border>

                                <Border Grid.Row="2" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <shared:PerformanceParameterRow
                                        x:Name="SpptParameterRow"
                                        Title="持续功耗"
                                        Description="长时间稳定运行功耗"
                                        Minimum="20"
                                        Maximum="120"
                                        Value="45"
                                        RecommendedValue="45"
                                        ControlLimitValue="120"
                                        Unit="W"
                                        HelpEffect="控制长时间负载的处理器功耗；提高会增强持续性能并增加热量。"
                                        HelpRecommendedRange="优先厂商当前值；内置办公标准档 55 W 仅作软件参考。"
                                        HelpSafeRange="保持已验证值，需降温时逐步下调；旧界面输入 20–120 W。"
                                        HelpExtremeLimit="120 W 仅是旧界面输入上限，实际须满足本机写入能力。"
                                        HelpRisk="提高会增加温度、风扇噪声与供电负载。"
                                        ValueChanged="OnSpptValueChanged">
                                        <shared:PerformanceParameterRow.IconContent>
                                            <FontIcon Glyph="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource PrototypeTextBrush}" />
                                        </shared:PerformanceParameterRow.IconContent>
                                    </shared:PerformanceParameterRow>
</Border>

                                <Border Grid.Row="3" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <shared:PerformanceParameterRow
                                        x:Name="SplParameterRow"
                                        Title="短时功耗"
                                        Description="短时加速最大功耗"
                                        Minimum="20"
                                        Maximum="105"
                                        Value="35"
                                        RecommendedValue="35"
                                        ControlLimitValue="105"
                                        Unit="W"
                                        HelpEffect="控制短时间峰值功耗；提高可改善突发负载响应，但会让温度短时间上冲。"
                                        HelpRecommendedRange="优先厂商当前值；内置办公标准档 55 W 仅作软件参考。"
                                        HelpSafeRange="保持已验证值，避免同时提高持续和短时功耗；旧界面输入 20–105 W。"
                                        HelpExtremeLimit="105 W 仅是旧界面输入上限，实际须满足本机写入能力。"
                                        HelpRisk="过高会造成短时温度上冲并增加供电压力。"
                                        ValueChanged="OnSplValueChanged">
                                        <shared:PerformanceParameterRow.IconContent>
                                            <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource PrototypeTextBrush}" />
                                        </shared:PerformanceParameterRow.IconContent>
                                    </shared:PerformanceParameterRow>
</Border>

                                <Border Grid.Row="4" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <shared:PerformanceParameterRow
                                        x:Name="FrequencyParameterRow"
                                        Title="最大频率"
                                        Description="全核心最大运行频率"
                                        Minimum="1500"
                                        Maximum="5400"
                                        Value="3800"
                                        StepFrequency="100"
                                        RecommendedValue="3800"
                                        ControlLimitValue="5400"
                                        Unit="MHz"
                                        TrailingWidth="158"
                                        HelpEffect="限制处理器最高加速频率；降低可减少突发功耗和温度。"
                                        HelpRecommendedRange="内置办公标准档 AC 3.8 GHz、DC 3.0 GHz 仅作软件参考。"
                                        HelpSafeRange="保持厂商当前上限；需节能时逐步下调，软件输入 1.5–5.4 GHz。"
                                        HelpExtremeLimit="5.4 GHz 是软件输入边界，不保证本机可以达到。"
                                        HelpRisk="提高可能增加噪音、功耗与稳定性风险。"
                                        ValueChanged="OnFrequencyValueChanged">
                                        <shared:PerformanceParameterRow.IconContent>
                                            <FontIcon Glyph="&#xE8A0;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource PrototypeTextBrush}" />
                                        </shared:PerformanceParameterRow.IconContent>
                                        <shared:PerformanceParameterRow.AccessoryContent>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button x:Name="FrequencyAcButton" Content="AC" Style="{StaticResource PerformanceSegmentButtonStyle}" Click="OnFrequencyAcClick" AutomationProperties.Name="编辑交流电最高频率" />
                                                <Button x:Name="FrequencyDcButton" Content="DC" Style="{StaticResource PerformanceSegmentButtonStyle}" Click="OnFrequencyDcClick" AutomationProperties.Name="编辑电池最高频率" />
                                            </StackPanel>
                                        </shared:PerformanceParameterRow.AccessoryContent>
                                    </shared:PerformanceParameterRow>
</Border>

                                <Border Grid.Row="5" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <shared:PerformanceParameterRow
                                        x:Name="CurveOptimizerParameterRow"
                                        Title="Curve Optimizer"
                                        Description="电压偏移优化"
                                        Minimum="-30"
                                        Maximum="0"
                                        Value="-15"
                                        RecommendedValue="-15"
                                        ControlLimitValue="-30"
                                        MinimumLabel="极限"
                                        MaximumLabel="安全"
                                        Unit="mV"
                                        HelpEffect="负值通常降低同频率下的请求电压和温度。"
                                        HelpRecommendedRange="优先沿用 BIOS；需要调整时从接近 0 的偏移开始验证。"
                                        HelpSafeRange="保持已验证偏移；曲线步数不等于固定毫伏数。"
                                        HelpExtremeLimit="-30 仅是界面负向输入边界，不代表通用稳定值。"
                                        HelpRisk="过度负压可能引发崩溃、重启或硬件纠错。"
                                        ValueChanged="OnCurveValueChanged">
                                        <shared:PerformanceParameterRow.IconContent>
                                            <FontIcon Glyph="&#xE9D9;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{StaticResource PrototypeTextBrush}" />
                                        </shared:PerformanceParameterRow.IconContent>
                                    </shared:PerformanceParameterRow>
</Border>

                                <Border Grid.Row="6" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
<Grid Style="{StaticResource PerformanceParameterRowStyle}" ColumnSpacing="10">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="38" />
<ColumnDefinition Width="154" />
<ColumnDefinition Width="28" />
<ColumnDefinition Width="*" />
<ColumnDefinition Width="88" />
<ColumnDefinition Width="34" />
</Grid.ColumnDefinitions>
<FontIcon Glyph="&#xE950;" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{StaticResource ModeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
<StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
<TextBlock Text="可用核心" Foreground="{StaticResource PrototypeTextBrush}" FontSize="16" FontWeight="SemiBold" />
<TextBlock Text="控制可用的 CPU 核心数" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
</StackPanel>
<Button Grid.Column="2" Content="?" Style="{StaticResource PerformanceInfoButtonStyle}" AutomationProperties.Name="可用核心说明" ToolTipService.ToolTip="作用：限制可调度核心数量，减少可能降低并行性能。推荐：保持全部可用核心。保守：保持系统当前配置。极限：以本机实际核心数量和可用控制为准，没有通用核心数。" />
<TextBlock Grid.Column="3" Text="只读硬件回读" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" />
<Border Grid.Column="4" Width="88" Height="40" CornerRadius="12" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
<TextBlock x:Name="AvailableCoreCountText" Text="不可用" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
</Border>
<TextBlock Grid.Column="5" Text="核心" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
</Grid>
</Border>
                            </Grid>
                        </ContentControl>
                    </Border>

                    <Border x:Name="RuntimePolicyPanel" Grid.Row="0" Grid.Column="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="18" Padding="22,18">
<Grid RowSpacing="12">
<Grid.RowDefinitions>
<RowDefinition Height="Auto" />
<RowDefinition Height="232" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
<RowDefinition Height="Auto" />
</Grid.RowDefinitions>
<Grid Grid.Row="0">
<TextBlock Text="CPU 运行边界" Foreground="{StaticResource PrototypeTextBrush}" FontSize="21" FontWeight="SemiBold" />
<StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right" VerticalAlignment="Center">
<Ellipse Width="10" Height="10" Fill="#FF12E681" />
<TextBlock Text="连接正常" Foreground="#FF12E681" FontSize="12" />
<TextBlock Text="未触发限制" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" Margin="8,0,0,0" />
</StackPanel>
</Grid>
<Grid Grid.Row="1" Height="232">
<Canvas Width="290" Height="232" HorizontalAlignment="Center" VerticalAlignment="Center">
<Ellipse Canvas.Left="42" Canvas.Top="12" Width="206" Height="206" Stroke="#18FFFFFF" StrokeThickness="1" />
<Path Data="M 45,101 A 86,86 0 0 1 112,28" Stroke="#FFFF3151" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
<Path Data="M 148,28 A 86,86 0 0 1 245,101" Stroke="#FFFF9B35" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
<Path Data="M 45,131 A 86,86 0 0 0 112,204" Stroke="#FF21B9FF" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
<Path Data="M 148,204 A 86,86 0 0 0 245,131" Stroke="#FFB34DFF" StrokeThickness="15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
<Border Canvas.Left="99" Canvas.Top="78" Width="92" Height="76" CornerRadius="12" Background="#D40A0D12" BorderBrush="#B9FFFFFF" BorderThickness="1">
<StackPanel VerticalAlignment="Center">
<TextBlock Text="CPU" Foreground="#CFFFFFFF" FontSize="19" HorizontalAlignment="Center" />
<TextBlock Text="LIVE" Foreground="#79FFFFFF" FontSize="9" HorizontalAlignment="Center" />
</StackPanel>
</Border>
</Canvas>
<StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="2">
<TextBlock x:Name="CpuTemperatureText" Text="-- °C" Foreground="#FFFF3151" FontSize="25" FontWeight="SemiBold" />
<TextBlock Text="CPU 温度" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" />
<TextBlock Text="上限 95 °C" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
</StackPanel>
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
<TextBlock x:Name="CpuPowerText" Text="-- W" Foreground="#FFFF9B35" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right" />
<TextBlock Text="封装功耗" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" />
<TextBlock Text="上限 80 W" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" />
</StackPanel>
<StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="2">
<TextBlock x:Name="CpuFrequencyText" Text="-- GHz" Foreground="#FF21B9FF" FontSize="24" FontWeight="SemiBold" />
<TextBlock Text="核心频率" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" />
<TextBlock Text="上限 5.2 GHz" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
</StackPanel>
<StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="2">
<TextBlock x:Name="CpuVoltageText" Text="-- V" Foreground="#FFB34DFF" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
<TextBlock Text="核心电压" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" />
<TextBlock Text="上限 1.400 V" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" />
</StackPanel>
</Grid>
<Border Grid.Row="2" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
<Grid ColumnSpacing="10">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*" />
<ColumnDefinition Width="Auto" />
</Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal" Spacing="8">
<TextBlock Text="CPU Boost（睿频加速）" Foreground="{StaticResource PrototypeTextBrush}" FontSize="15" FontWeight="SemiBold" />
