                                    <TextBlock Grid.Column="1" Text="回到办公" Foreground="{StaticResource PrototypeTextBrush}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="OfficeConditionText" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Button Click="OnToggleRuleDetails" Style="{StaticResource AutoMapRowButton}" Height="48" Padding="12,0" AutomationProperties.AutomationId="Auto.RulesDetails" AutomationProperties.Name="展开应用规则与决策记录状态">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/Automation/RulesDocument.png" Width="29" Height="32" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Grid.Column="1" Text="应用规则与决策记录" Foreground="{StaticResource PrototypeTextBrush}" FontSize="17" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="RulesExpansionLabel" Text="展开" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="15" VerticalAlignment="Center"/>
                                    <Image Source="ms-appx:///Assets/Automation/SelectorChevron.png" Width="24" Height="22" Grid.Column="3" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Button>
                            <TextBlock x:Name="RulesDetailsText" Text="尚无应用规则或决策记录。当前方案处于预览状态，候选阈值仍需本机验证。" Visibility="Collapsed" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="StrategyStatusText" Visibility="Collapsed" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="13" Margin="4,10,4,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
