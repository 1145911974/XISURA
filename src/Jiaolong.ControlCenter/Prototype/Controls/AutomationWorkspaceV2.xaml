                                </Grid>
                            </Border>
                            <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="10" MinHeight="44" Padding="12,4">
