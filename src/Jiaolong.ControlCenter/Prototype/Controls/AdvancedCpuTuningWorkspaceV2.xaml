<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:shared="using:Jiaolong_ControlCenter.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Jiaolong_ControlCenter.Prototype.Controls.AdvancedCpuTuningWorkspaceV2">
    <Grid Padding="0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AdvancedSmuPanel" Grid.Column="0" Background="{StaticResource PerformanceV2CardBrush}" BorderBrush="{StaticResource PerformanceV2CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PerformanceV2CardCornerRadius}" Padding="18">
                <StackPanel Spacing="4">
                    <Grid Height="38">
                        <TextBlock Text="功耗与电流" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="22" VerticalAlignment="Center">
                            <TextBlock Text="编辑值" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock Text="推荐值" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock Text="控制上限" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                        <TextBlock Text="功耗边界" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                        <shared:ParameterHelpButton x:Name="PowerBoundaryHelp" ParameterName="功耗边界" />
                    </StackPanel>
                    <shared:AdvancedCpuFieldRowV2 x:Name="StapmRow" Label="STAPM（短时功耗）" Description="平台短时功耗限制" Minimum="45" Maximum="75" RecommendedValue="55" LimitValue="75" Unit="W" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="FastPptRow" Label="Fast PPT（瞬时功耗）" Description="瞬时封装功耗限制" Minimum="45" Maximum="75" RecommendedValue="55" LimitValue="75" Unit="W" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="SlowPptRow" Label="Slow PPT（长时功耗）" Description="持续封装功耗限制" Minimum="45" Maximum="75" RecommendedValue="55" LimitValue="75" Unit="W" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="PptRow" Label="PPT（总封装功耗）" Description="总封装功耗边界" Minimum="45" Maximum="75" RecommendedValue="55" LimitValue="75" Unit="W" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                        <TextBlock Text="电流边界" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                        <shared:ParameterHelpButton x:Name="CurrentBoundaryHelp" ParameterName="电流边界" />
                    </StackPanel>
                    <shared:AdvancedCpuFieldRowV2 x:Name="VrmRow" Label="VRM（VRM 电流上限）" Description="供电模块电流限制" Minimum="1000" Maximum="200000" RecommendedValue="90000" LimitValue="200000" DisplayScale="0.001" Unit="A" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="TdcRow" Label="TDC（持续电流）" Description="持续电流限制" Minimum="1000" Maximum="200000" RecommendedValue="95000" LimitValue="200000" DisplayScale="0.001" Unit="A" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="EdcRow" Label="EDC（峰值电流）" Description="峰值电流限制" Minimum="1000" Maximum="200000" RecommendedValue="140000" LimitValue="200000" DisplayScale="0.001" Unit="A" />
                </StackPanel>
            </Border>
            <Border x:Name="AdvancedPboPanel" Grid.Column="1" Background="{StaticResource PerformanceV2CardBrush}" BorderBrush="{StaticResource PerformanceV2CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PerformanceV2CardCornerRadius}" Padding="18">
                <StackPanel Spacing="4">
                    <Grid Height="38">
                        <TextBlock Text="核心与自动加速" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="22" VerticalAlignment="Center">
                            <TextBlock Text="编辑值" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock Text="推荐值" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock Text="控制上限" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid Height="74" ColumnSpacing="16" AutomationProperties.Name="核心状态，只读">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="核心状态" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                            <shared:ParameterHelpButton x:Name="CoreHelpButton" ParameterName="核心状态" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="96">
                            <TextBlock Text="启用核心" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock x:Name="EnabledCoreValueText" Text="--" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrototypeTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="96">
                            <TextBlock Text="逻辑处理器" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                            <TextBlock x:Name="LogicalProcessorValueText" Text="--" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrototypeTextBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,2">
                        <TextBlock Text="Windows 核心停泊" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                        <shared:ParameterHelpButton x:Name="CoreParkingHelp" ParameterName="核心停泊" />
                    </StackPanel>
                    <shared:AdvancedCpuFieldRowV2 x:Name="CoreParkingAcRow" Label="接通电源 · 最低活跃比例" Description="逻辑处理器最低唤醒比例" Minimum="0" Maximum="100" RecommendedValue="100" LimitValue="100" Unit="%" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="CoreParkingDcRow" Label="电池供电 · 最低活跃比例" Description="逻辑处理器最低唤醒比例" Minimum="0" Maximum="100" RecommendedValue="25" LimitValue="100" Unit="%" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                        <TextBlock Text="自动加速" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                        <shared:ParameterHelpButton x:Name="AutoBoostHelp" ParameterName="自动加速" />
                    </StackPanel>
                    <shared:AdvancedCpuFieldRowV2 x:Name="PboScalarRow" Label="PBO Scalar（倍频放大）" Description="自动加速判断尺度" Minimum="1" Maximum="10" RecommendedValue="1" LimitValue="10" Unit="X" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,8">
                        <TextBlock Text="逐核曲线细调" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                        <shared:ParameterHelpButton x:Name="CurveHelp" ParameterName="逐核曲线细调" />
                    </StackPanel>
                    <TextBlock x:Name="PerCoreModeHint" Text="逐核偏移" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                    <StackPanel x:Name="PerCoreCurvePanel" Spacing="8" Margin="0,8,0,0">
                        <ComboBox x:Name="CurveCoreSelector" HorizontalAlignment="Stretch" PlaceholderText="等待核心拓扑" SelectionChanged="OnCoreSelectionChanged" AutomationProperties.Name="选择曲线优化核心，显示已编辑偏移" />
                        <shared:AdvancedCpuFieldRowV2 x:Name="PerCoreCurveRow" Label="核心偏移" Description="仅编辑所选核心，其他核心值保留" Minimum="-30" Maximum="0" RecommendedValue="0" LimitValue="0" Unit="步" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
                        <TextBlock Text="温度边界" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}" />
                        <shared:ParameterHelpButton x:Name="TemperatureBoundaryHelp" ParameterName="温度边界" />
                    </StackPanel>
                    <shared:AdvancedCpuFieldRowV2 x:Name="Mp1Row" Label="MP1（核心温度上限）" Description="核心温度保护阈值" Minimum="40" Maximum="100" RecommendedValue="95" LimitValue="100" Unit="°C" />
                    <shared:AdvancedCpuFieldRowV2 x:Name="RsmuRow" Label="RSMU（核心温度上限）" Description="本机与 MP1 为同一温限" Minimum="40" Maximum="100" RecommendedValue="90" LimitValue="100" Unit="°C" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource PerformanceV2CardBrush}" BorderBrush="{StaticResource PerformanceV2CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PerformanceV2CardCornerRadius}" Padding="18,0">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource ModeAccentBrush}" />
                    <TextBlock Text="硬件读取状态" FontSize="13" Foreground="{StaticResource PrototypeSecondaryTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="AvailabilityText" Text="等待硬件回读" FontSize="13" Foreground="{StaticResource PrototypeSecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="UnsavedText" Grid.Column="3" Text="有未保存的更改" FontSize="12" Foreground="{StaticResource ModeAccentBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>