<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Jiaolong_ControlCenter.Prototype.Controls.HomeModeBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Jiaolong_ControlCenter.Prototype.Controls" Width="729" Height="168">
    <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#36FFFFFF" BorderThickness="1" CornerRadius="20">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border x:Name="OfficeCard" Grid.Column="0" Margin="4" Background="Transparent" CornerRadius="16">
                <Grid>
                    <Border x:Name="OfficeSelectionSurface" Background="{StaticResource ModeSelectionBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="16" />
                    <controls:PrototypeButton x:Name="ModeOffice" Tag="Office" Click="OnModeClick" Style="{StaticResource PrototypeModeButtonStyle}" AutomationProperties.AutomationId="Mode.Office"><Grid Width="150" Height="124"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><Grid Width="42" Height="42"><Canvas x:Name="OfficeIconGlowHost" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" /><Image x:Name="OfficeModeIcon" Source="ms-appx:///Assets/Icons/HomeModeOfficeOutline.svg" Width="36" Height="36" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="ModeIconScale" /></Image.RenderTransform></Image></Grid><TextBlock Text="办公" Style="{StaticResource PrototypeModeTextStyle}" TextAlignment="Center" /><Border x:Name="OfficeIndicator" Height="3" Width="46" HorizontalAlignment="Center" CornerRadius="2" Background="{StaticResource ModeAccentBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="1" /></Border.RenderTransform></Border></StackPanel></Grid></controls:PrototypeButton>
                </Grid>
            </Border>
            <Border x:Name="GamingCard" Grid.Column="2" Margin="4" Background="Transparent" CornerRadius="16">
                <Grid>
                    <Border x:Name="GamingSelectionSurface" Background="{StaticResource ModeSelectionBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="16" Opacity="0" />
                    <controls:PrototypeButton x:Name="ModeGaming" Tag="Gaming" Click="OnModeClick" Style="{StaticResource PrototypeModeButtonStyle}" AutomationProperties.AutomationId="Mode.Gaming"><Grid Width="150" Height="124"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><Grid Width="42" Height="42"><Canvas x:Name="GamingIconGlowHost" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" /><Image x:Name="GamingModeIcon" Source="ms-appx:///Assets/Icons/HomeModeGamingOutline.svg" Width="36" Height="36" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="GamingIconScale" /></Image.RenderTransform></Image></Grid><TextBlock Text="游戏" Style="{StaticResource PrototypeModeTextStyle}" TextAlignment="Center" /><Border x:Name="GamingIndicator" Height="3" Width="46" HorizontalAlignment="Center" CornerRadius="2" Background="{StaticResource ModeAccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border></StackPanel></Grid></controls:PrototypeButton>
                </Grid>
            </Border>
            <Border x:Name="TurboCard" Grid.Column="4" Margin="4" Background="Transparent" CornerRadius="16">
                <Grid>
                    <Border x:Name="TurboSelectionSurface" Background="{StaticResource ModeSelectionBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="16" Opacity="0" />
                    <controls:PrototypeButton x:Name="ModeTurbo" Tag="Turbo" Click="OnModeClick" Style="{StaticResource PrototypeModeButtonStyle}" AutomationProperties.AutomationId="Mode.Turbo" />
                    <Grid x:Name="TurboIconMotionHost" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,38,0,0" IsHitTestVisible="False"><Grid.RenderTransform><TranslateTransform x:Name="TurboIconTransform" /></Grid.RenderTransform><Canvas x:Name="TurboIconGlowHost" Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" /><Image x:Name="TurboMotionIcon" Source="ms-appx:///Assets/Icons/HomeModeTurboOutline.svg" Width="35" Height="35" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="TurboIconScale" /></Image.RenderTransform></Image></Grid>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" IsHitTestVisible="False">
                        <Grid.RenderTransform><TranslateTransform x:Name="TurboLabelTransform" /></Grid.RenderTransform>
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="TurboMotionLabel" Text="狂飙" Style="{StaticResource PrototypeModeTextStyle}" TextAlignment="Center" />
                            <Border x:Name="TurboNormalIndicator" Width="46" Height="3" HorizontalAlignment="Center" CornerRadius="2" Background="{StaticResource ModeAccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border>
                        </StackPanel>
                    </Grid>
                    <controls:PrototypeButton x:Name="TurboHeaderButton" MinHeight="44" Height="68" VerticalAlignment="Top" Tag="Normal" Click="OnChildOptionClick" Style="{StaticResource PrototypeModeTierButtonStyle}" AutomationProperties.AutomationId="Turbo.Normal" AutomationProperties.Name="普通狂飙" IsHitTestVisible="False" />
                    <Grid x:Name="TurboOptions" Height="50" Margin="7,108,7,0" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform><TranslateTransform x:Name="TurboOptionsTransform" Y="12" /></Grid.RenderTransform>
                        <Grid x:Name="TurboOptionGrid">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <controls:PrototypeButton x:Name="TurboQuietButton" Grid.Column="0" MinHeight="44" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Tag="Quiet" Click="OnChildOptionClick" Style="{StaticResource PrototypeModeTierButtonStyle}" AutomationProperties.AutomationId="Turbo.Quiet" AutomationProperties.Name="静音狂飙">
                                <StackPanel Width="78" Spacing="7"><TextBlock Text="静音狂飙" Style="{StaticResource PrototypeTierTextStyle}" TextAlignment="Center" /><Border x:Name="TurboQuietIndicator" Width="32" Height="2" HorizontalAlignment="Center" CornerRadius="1" Background="{StaticResource ModeAccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border></StackPanel>
                            </controls:PrototypeButton>
                            <controls:PrototypeButton x:Name="TurboExtremeButton" Grid.Column="1" MinHeight="44" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Tag="Extreme" Click="OnChildOptionClick" Style="{StaticResource PrototypeModeTierButtonStyle}" AutomationProperties.AutomationId="Turbo.Extreme" AutomationProperties.Name="极限狂飙">
                                <StackPanel Width="78" Spacing="7"><TextBlock Text="极限狂飙" Style="{StaticResource PrototypeTierTextStyle}" TextAlignment="Center" /><Border x:Name="TurboExtremeIndicator" Width="32" Height="2" HorizontalAlignment="Center" CornerRadius="1" Background="{StaticResource ModeAccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border></StackPanel>
                            </controls:PrototypeButton>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="CustomCard" Grid.Column="6" Margin="4" Background="Transparent" CornerRadius="16">
                <Grid>
                    <Border x:Name="CustomSelectionSurface" Background="{StaticResource ModeSelectionBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="16" Opacity="0" />
                    <controls:PrototypeButton x:Name="ModeCustom" Tag="Custom" Click="OnModeClick" Style="{StaticResource PrototypeModeButtonStyle}" AutomationProperties.AutomationId="Mode.Custom" />
                    <Grid x:Name="CustomIconMotionHost" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,38,0,0" IsHitTestVisible="False"><Grid.RenderTransform><TranslateTransform x:Name="CustomIconTransform" /></Grid.RenderTransform><Canvas x:Name="CustomIconGlowHost" Width="35" Height="35" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" /><Image x:Name="CustomMotionIcon" Source="ms-appx:///Assets/Icons/HomeModeCustomOutline.svg" Width="35" Height="35" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform x:Name="CustomIconScale" /></Image.RenderTransform></Image></Grid>
                    <TextBlock x:Name="CustomMotionLabel" Text="自定义" Style="{StaticResource PrototypeModeTextStyle}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" IsHitTestVisible="False">
                        <TextBlock.RenderTransform><TranslateTransform x:Name="CustomLabelTransform" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <Grid x:Name="CustomOptions" Height="50" Margin="5,108,5,0" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                        <Grid.RenderTransform><TranslateTransform x:Name="CustomOptionsTransform" Y="12" /></Grid.RenderTransform>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <controls:PrototypeButton Grid.Column="0" MinHeight="44" Tag="Profile1" Click="OnChildOptionClick" Style="{StaticResource PrototypeModeTierButtonStyle}" AutomationProperties.Name="预设一" AutomationProperties.AutomationId="Mode.Custom.Profile1"><StackPanel Width="50" Spacing="7"><TextBlock Text="预设一" Style="{StaticResource PrototypeTierTextStyle}" TextAlignment="Center" /><Border x:Name="CustomProfile1Indicator" Width="28" Height="2" HorizontalAlignment="Center" CornerRadius="1" Background="{StaticResource ModeAccentBrush}" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="1" /></Border.RenderTransform></Border></StackPanel></controls:PrototypeButton>
                        <controls:PrototypeButton Grid.Column="1" MinHeight="44" Tag="Profile2" Click="OnChildOptionClick" Style="{StaticResource PrototypeModeTierButtonStyle}" AutomationProperties.Name="预设二" AutomationProperties.AutomationId="Mode.Custom.Profile2"><StackPanel Width="50" Spacing="7"><TextBlock Text="预设二" Style="{StaticResource PrototypeTierTextStyle}" TextAlignment="Center" /><Border x:Name="CustomProfile2Indicator" Width="28" Height="2" HorizontalAlignment="Center" CornerRadius="1" Background="{StaticResource ModeAccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border></StackPanel></controls:PrototypeButton>
                        <controls:PrototypeButton Grid.Column="2" MinHeight="44" Tag="Profile3" Click="OnChildOptionClick" Style="{StaticResource PrototypeModeTierButtonStyle}" AutomationProperties.Name="预设三" AutomationProperties.AutomationId="Mode.Custom.Profile3"><StackPanel Width="50" Spacing="7"><TextBlock Text="预设三" Style="{StaticResource PrototypeTierTextStyle}" TextAlignment="Center" /><Border x:Name="CustomProfile3Indicator" Width="28" Height="2" HorizontalAlignment="Center" CornerRadius="1" Background="{StaticResource ModeAccentBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleX="0" /></Border.RenderTransform></Border></StackPanel></controls:PrototypeButton>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" HorizontalAlignment="Left" Width="1" Margin="0,18" Background="#30FFFFFF" /><Border Grid.Column="3" HorizontalAlignment="Left" Width="1" Margin="0,18" Background="#30FFFFFF" /><Border Grid.Column="5" HorizontalAlignment="Left" Width="1" Margin="0,18" Background="#30FFFFFF" />
        </Grid>
    </Border>
</UserControl>
