<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Prototype.Controls.HomeSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Prototype.Controls"
    Width="292"
    Height="1045">
    <Border Background="{StaticResource PrototypeSidebarAcrylicBrush}">
        <Canvas>
            <Grid Canvas.Left="30" Canvas.Top="18" Width="232" Height="74"
                  AutomationProperties.Name="Have you tried turning it off and on again?">
                <Image Source="ms-appx:///Assets/Brand/SidebarQuip.svg" Width="232" Height="72" Stretch="Uniform" />
                <Path Data="M 0,3 C 22,-1 58,7 96,1 M 55,8 Q 76,5 101,7" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Opacity="0.85" />
            </Grid>

            <Border
                x:Name="NavSelectionIndicator"
                Canvas.Left="0"
                Canvas.Top="106"
                Canvas.ZIndex="0"
                Width="292"
                Height="74"
                Background="{StaticResource ModeNavSelectionBrush}"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <CompositeTransform />
                </Border.RenderTransform>
                <Border Width="4" HorizontalAlignment="Left" Background="{StaticResource ModeAccentBrush}" />
            </Border>

            <StackPanel Canvas.Left="0" Canvas.Top="106" Width="292" Canvas.ZIndex="1">
                <controls:PrototypeButton x:Name="NavHome" Tag="Home" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" AutomationProperties.AutomationId="Nav.Home">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavHomeIcon" Source="ms-appx:///Assets/Icons/NavHomeFilled.svg" Width="26" Height="26" Opacity="1" /></Viewbox><TextBlock Text="主页" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
                <controls:PrototypeButton x:Name="NavPerformance" Tag="Performance" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" AutomationProperties.AutomationId="Nav.Performance">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavPerformanceIcon" Source="ms-appx:///Assets/Icons/NavPerformanceFilled.svg" Width="25" Height="25" Opacity="0.72" /></Viewbox><TextBlock Text="性能" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
                <controls:PrototypeButton x:Name="NavGpu" Tag="Gpu" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" AutomationProperties.AutomationId="Nav.Gpu">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavGpuIcon" Source="ms-appx:///Assets/Icons/NavGpuFilled.svg" Width="24" Height="24" Opacity="0.72" /></Viewbox><TextBlock Text="显卡" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
                <controls:PrototypeButton x:Name="NavFan" Tag="Fan" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" AutomationProperties.AutomationId="Nav.Fan">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavFanIcon" Source="ms-appx:///Assets/Icons/NavFanFilled.svg" Width="25" Height="25" Opacity="0.72" /></Viewbox><TextBlock Text="风扇" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
                <controls:PrototypeButton x:Name="NavLighting" Tag="Lighting" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" AutomationProperties.AutomationId="Nav.Lighting">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavLightingIcon" Source="ms-appx:///Assets/Icons/NavLightingFilled.svg" Width="26" Height="26" Opacity="0.72" /></Viewbox><TextBlock Text="灯光" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
                <controls:PrototypeButton x:Name="NavAutomation" Tag="Automation" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" AutomationProperties.AutomationId="Nav.Automation">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavAutomationIcon" Source="ms-appx:///Assets/Icons/NavAutomationFilled.svg" Width="25" Height="25" Opacity="0.72" /></Viewbox><TextBlock Text="自动" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
                <controls:PrototypeButton x:Name="NavSettings" Tag="Settings" Click="OnNavigationClick" Style="{StaticResource PrototypeNavButtonStyle}" AutomationProperties.AutomationId="Nav.Settings">
                    <StackPanel Orientation="Horizontal" Spacing="22"><Viewbox Width="26" Height="26"><Image x:Name="NavSettingsIcon" Source="ms-appx:///Assets/Icons/NavSettingsFilled.svg" Width="25" Height="25" Opacity="0.72" /></Viewbox><TextBlock Text="设置" VerticalAlignment="Center" Style="{StaticResource PrototypeNavigationTextStyle}" /></StackPanel>
                </controls:PrototypeButton>
            </StackPanel>


            <Grid Canvas.Left="36" Canvas.Top="738" Width="220" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="快捷菜单" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <controls:PrototypeButton
                    x:Name="EditQuickMenuButton"
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Padding="0"
                    Click="OnEditQuickMenuClick"
                    Style="{StaticResource PrototypeQuickActionStyle}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="0"
                    Tag="编辑快捷菜单"
                    AutomationProperties.Name="编辑快捷菜单"
                    ToolTipService.ToolTip="编辑快捷菜单">
                    <FontIcon Glyph="&#xE8FD;" FontFamily="Segoe Fluent Icons" FontSize="14" />
                </controls:PrototypeButton>
            </Grid>

            <Grid x:Name="QuickSettingsGrid" Canvas.Left="36" Canvas.Top="790" Width="220" Height="214" RowSpacing="12" ColumnSpacing="15">
                <Grid.RowDefinitions><RowDefinition Height="61" /><RowDefinition Height="61" /><RowDefinition Height="61" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="61" /><ColumnDefinition Width="61" /><ColumnDefinition Width="61" /></Grid.ColumnDefinitions>
            </Grid>
        </Canvas>
    </Border>
</UserControl>
