                                <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="最近配置" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsLastConfigurationText" Text="读取中" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="待处理" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsPendingConfigurationText" Text="读取中" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                    <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource ModeAccentBrush}" FontSize="13" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <Grid x:Name="SettingsDetailsCards" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="SettingsDeviceFirmwareCard" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Top">
                            <StackPanel>
                                <Button x:Name="SettingsDeviceFirmwareHeader" Style="{StaticResource DefaultButtonStyle}" Tag="设备与服务" Click="OnToggleDeviceFirmwareDetails" Padding="20,16" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开设备与服务" CornerRadius="16">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="PrototypeTextBrush"/>
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="PrototypeTextBrush"/>
                                    </Button.Resources>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="设备与服务" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="SettingsCapabilityBadgeText" Text="读取中" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" x:Name="SettingsDeviceFirmwareChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Grid x:Name="SettingsDeviceFirmwareContentHost" Height="0" Visibility="Collapsed">
                                    <Border x:Name="SettingsDeviceFirmwareContent" Background="Transparent" Padding="20,0,20,18">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="设备与固件" FontSize="15" FontWeight="SemiBold" />
                                            <Grid RowSpacing="12" ColumnSpacing="24"><Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource PrototypeDividerBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="主板" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsBoardText" Text="未知" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="BIOS" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsBiosText" Text="未知" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                                            <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="处理器" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsCpuModelText" Text="未知" FontSize="13" TextWrapping="Wrap"/></StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5"><TextBlock Text="可用控制" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsCapabilityCountText" Text="未知" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                        </Grid>
                                            <TextBlock Text="服务与依赖" FontSize="15" FontWeight="SemiBold" />
                                            <Grid RowSpacing="12" ColumnSpacing="16"><Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource PrototypeDividerBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="核心服务" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock Text="JiaolongControlService" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SettingsServiceConnectionText" Text="未知" FontSize="12" VerticalAlignment="Bottom" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/>
                                            <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="恢复策略" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock x:Name="SettingsRecoveryPlanText" Text="读取中" FontSize="14" FontWeight="SemiBold"/></StackPanel>
                                            <Button Grid.Row="2" Grid.Column="1" Content="程序与依赖文件" Click="OnOpenOfficialInstallerFolder" Height="32" Padding="12,0" VerticalAlignment="Bottom" AutomationProperties.Name="打开程序与依赖文件目录" ToolTipService.ToolTip="打开当前程序的安装目录，查看程序与依赖文件"/>
                                        </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" x:Name="SettingsProjectSupportCard" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Top">
                            <StackPanel>
                                <Button x:Name="SettingsProjectSupportHeader" Style="{StaticResource DefaultButtonStyle}" Tag="项目与支持" Click="OnToggleProjectSupportDetails" Padding="20,16" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开项目与支持" CornerRadius="16">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="PrototypeTextBrush"/>
                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="PrototypeTextBrush"/>
                                    </Button.Resources>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
