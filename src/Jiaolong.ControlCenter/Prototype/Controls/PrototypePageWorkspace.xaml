                                    <Button.Flyout><MenuFlyout>
                                        <MenuFlyoutItem Text="检查服务连接" Click="OnSettingsRepair" AutomationProperties.Name="检查服务"/>
                                        <MenuFlyoutItem Text="导出诊断包" Click="OnSettingsExport" AutomationProperties.Name="导出诊断包"/>
                                        <MenuFlyoutItem Text="查看修复说明" Click="OnSettingsRepairNotes" AutomationProperties.Name="查看修复说明"/>
                                    </MenuFlyout></Button.Flyout>
                                </Button>
                            </Grid>
                            <Rectangle Grid.Row="1" Fill="{StaticResource PrototypeDividerBrush}"/>
