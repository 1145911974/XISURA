<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Prototype.Controls.PrototypePageWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jiaolong_ControlCenter.Prototype.Controls"
    Width="1380"
    Height="1045">
    <UserControl.Resources>
        <Style x:Key="PerformanceSegmentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeSecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PerformanceAdvancedNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PerformanceMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource PrototypeControlAcrylicBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="WorkspaceRoot" Padding="18,30,18,28">
        <Grid x:Name="GpuPage" Visibility="Collapsed" AutomationProperties.AutomationId="Page.Gpu">
            <Grid.Resources>
                <AcrylicBrush x:Key="GpuGlassSurfaceBrush" TintColor="#090C12" TintOpacity="0.58" TintLuminosityOpacity="0.34" FallbackColor="#C60A0D13" />
                <SolidColorBrush x:Key="GpuMonitorOnlineBrush" Color="#45D39A" />
                <SolidColorBrush x:Key="GpuMonitorOfflineBrush" Color="#F06A75" />
                <SolidColorBrush x:Key="GpuCardBgBrush" Color="#0B1322" />
                <SolidColorBrush x:Key="GpuCardBorderBrush" Color="#172437" />
                <SolidColorBrush x:Key="GpuAccentBlueBrush" Color="#0084FF" />
                <SolidColorBrush x:Key="GpuTextPrimaryBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="GpuTextSecondaryBrush" Color="#7B8DA5" />
                <SolidColorBrush x:Key="GpuTextMutedBrush" Color="#55687D" />

                <!-- Progress Bar Fill Brushes -->
                <LinearGradientBrush x:Key="GpuGreenGradientBrush" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00E575" Offset="0.0" />
                    <GradientStop Color="#00F29D" Offset="1.0" />
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="GpuBlueGradientBrush" StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0084FF" Offset="0.0" />
                    <GradientStop Color="#00D2FF" Offset="1.0" />
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="GpuActiveMuxBgBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D2340" Offset="0.0" />
                    <GradientStop Color="#091526" Offset="1.0" />
                </LinearGradientBrush>

                <LinearGradientBrush x:Key="GpuTrendAreaGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#4D00F29D" Offset="0.0" />
                    <GradientStop Color="#0000F29D" Offset="1.0" />
                </LinearGradientBrush>

                <!-- Clean Card Button Style -->
                <Style x:Key="GpuModeCardButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. 顶部 Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Spacing="4">
                    <TextBlock Text="显卡" Foreground="#FFFFFF" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="专业级性能调控，释放显卡全部潜力" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" />
                </StackPanel>

                <!-- 右侧 GPU 选择器胶囊卡片 -->
                <Border Grid.Column="1" Background="#0C1524" BorderBrush="#1C2B40" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Ellipse x:Name="GpuMonitorStatusDot" Width="7" Height="7" Fill="{StaticResource GpuMonitorOnlineBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="GpuMonitorStatusText" Text="NVIDIA GeForce RTX 4070" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#7B8DA5" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 主内容可滚动区 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18" Padding="0,0,0,16">

                    <!-- 2. 显卡输出设置 (GPU Output Settings) -->
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="显卡输出设置" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="MuxStatusText" Text="独显直连生效中" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 4张等宽模式卡片 -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 卡片 1: 独显直连 (默认激活态) -->
                            <Button x:Name="GpuDiscreteButton" Grid.Column="0" Tag="Discrete" Click="OnMuxModeCardClick" Style="{StaticResource GpuModeCardButtonStyle}">
                                <Border x:Name="GpuDiscreteCardBorder" Background="{StaticResource GpuActiveMuxBgBrush}" BorderBrush="{StaticResource GpuAccentBlueBrush}" BorderThickness="1.5" CornerRadius="10" Padding="14,14" Height="86">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 电源插头图标 -->
                                        <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="M9,2 L9,6 M15,2 L15,6 M7,6 L17,6 C18,6 19,7 19,8 L19,13 C19,15.2 17.2,17 15,17 L15,21 C15,21.5 14.5,22 14,22 L10,22 C9.5,22 9,21.5 9,21 L9,17 C6.8,17 5,15.2 5,13 L5,8 C5,7 6,6 7,6 Z"
                                                  Stroke="{StaticResource GpuAccentBlueBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                                        </Grid>

                                        <!-- 文本描述 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="独显直连" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="直接使用独立显卡&#x0a;获得最佳游戏性能" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="11" LineHeight="15" />
                                        </StackPanel>

                                        <!-- 选中徽标 (✓) -->
                                        <Border x:Name="GpuDiscreteBadge" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource GpuAccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Visible">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- 卡片 2: 混合输出 -->
                            <Button x:Name="GpuHybridButton" Grid.Column="1" Tag="Hybrid" Click="OnMuxModeCardClick" Style="{StaticResource GpuModeCardButtonStyle}">
                                <Border x:Name="GpuHybridCardBorder" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14" Height="86">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 双向循环图标 -->
                                        <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="M4,11 A7,7 0 0,1 17,6.5 M17,3 L17,6.5 L13.5,6.5 M20,13 A7,7 0 0,1 7,17.5 M7,21 L7,17.5 L10.5,17.5"
                                                  Stroke="#6F8298" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="混合输出" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="平衡性能与续航&#x0a;适合日常使用" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="11" LineHeight="15" />
                                        </StackPanel>

                                        <Border x:Name="GpuHybridBadge" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource GpuAccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- 卡片 3: 集显优先 -->
                            <Button x:Name="GpuEcoButton" Grid.Column="2" Tag="Eco" Click="OnMuxModeCardClick" Style="{StaticResource GpuModeCardButtonStyle}">
                                <Border x:Name="GpuEcoCardBorder" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14" Height="86">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 绿叶节能图标 -->
                                        <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="M18,4 C11,4 5.5,9 5.5,14.5 C5.5,18 8,20.5 11.5,21 C11.5,16 14.5,12 18,10.5 M6,21 C6.5,18.5 8,16 11,14"
                                                  Stroke="#6F8298" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="集显优先" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="延长续航时间&#x0a;适合轻度使用" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="11" LineHeight="15" />
                                        </StackPanel>

                                        <Border x:Name="GpuEcoBadge" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource GpuAccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- 卡片 4: 自动切换 -->
                            <Button x:Name="GpuAutoButton" Grid.Column="3" Tag="Auto" Click="OnMuxModeCardClick" Style="{StaticResource GpuModeCardButtonStyle}">
                                <Border x:Name="GpuAutoCardBorder" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,14" Height="86">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 圆形 A 智能切换图标 -->
                                        <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse Stroke="#6F8298" StrokeThickness="1.8" />
                                            <TextBlock Text="A" Foreground="#6F8298" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="自动切换" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="根据场景智能切换&#x0a;兼顾性能与续航" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="11" LineHeight="15" />
                                        </StackPanel>

                                        <Border x:Name="GpuAutoBadge" Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{StaticResource GpuAccentBlueBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 3. 中部双列：实时监控 (左 4.6*) vs 使用率趋势 (右 5.4*) -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4.6*" />
                            <ColumnDefinition Width="5.4*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列: 实时监控 8 项进度条看板 -->
                        <Border Grid.Column="0" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18">
                            <StackPanel Spacing="13">
                                <TextBlock Text="实时监控" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />

                                <!-- 1. GPU 使用率 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU 使用率" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuUsageText" Grid.Column="1" Text="72%" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0%" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuUsageColActive" Width="72*" />
                                            <ColumnDefinition x:Name="GpuUsageColInactive" Width="28*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuGreenGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="100%" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 2. GPU 温度 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU 温度" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuTemperatureText" Grid.Column="1" Text="56°C" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0°C" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuTempColActive" Width="56*" />
                                            <ColumnDefinition x:Name="GpuTempColInactive" Width="44*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuBlueGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="100°C" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 3. 核心频率 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="核心频率" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuFrequencyText" Grid.Column="1" Text="2730 MHz" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuFreqColActive" Width="2730*" />
                                            <ColumnDefinition x:Name="GpuFreqColInactive" Width="270*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuBlueGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="3000" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 4. 显存频率 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显存频率" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuMemoryFrequencyText" Grid.Column="1" Text="8501 MHz" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuMemFreqColActive" Width="8501*" />
                                            <ColumnDefinition x:Name="GpuMemFreqColInactive" Width="3499*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuBlueGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="12000" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 5. 显存占用 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显存占用" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuMemoryText" Grid.Column="1" Text="6.2 / 12 GB" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuMemUsedColActive" Width="6.2*" />
                                            <ColumnDefinition x:Name="GpuMemUsedColInactive" Width="5.8*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuBlueGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="12 GB" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 6. 功耗 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="功耗" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuPowerText" Grid.Column="1" Text="168 W" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuPowerColActive" Width="168*" />
                                            <ColumnDefinition x:Name="GpuPowerColInactive" Width="132*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuGreenGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="300 W" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 7. 风扇转速 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="风扇转速" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuPageFanText" Grid.Column="1" Text="1520 RPM" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuFanColActive" Width="1520*" />
                                            <ColumnDefinition x:Name="GpuFanColInactive" Width="1480*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuBlueGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="3000" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>

                                <!-- 8. 电压 -->
                                <Grid Height="22" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="电压" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="GpuVoltageText" Grid.Column="1" Text="0.975 V" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="0" Grid.Column="2" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Grid Grid.Column="3" Height="8" CornerRadius="4" Background="#121C2B" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="GpuVoltColActive" Width="0.975*" />
                                            <ColumnDefinition x:Name="GpuVoltColInactive" Width="0.225*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Background="{StaticResource GpuBlueGradientBrush}" />
                                    </Grid>
                                    <TextBlock Text="1.2" Grid.Column="4" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 右列: GPU 使用率趋势图与统计卡 -->
                        <Border Grid.Column="1" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 趋势图标题与时间切换 -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="GPU 使用率趋势" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" Background="#0C1524" BorderBrush="#1C2B40" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="1 分钟" Foreground="#A0B2C6" FontSize="12" />
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="#7B8DA5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 折线/渐变波形绘图区 -->
                                <Grid Grid.Row="1" Margin="0,14,0,0" MinHeight="145">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Y 轴刻度文本 -->
                                    <Grid Grid.Column="0" VerticalAlignment="Stretch">
                                        <TextBlock Text="100%" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,-2,8,0" />
                                        <TextBlock Text="75%" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,32,8,0" />
                                        <TextBlock Text="50%" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                        <TextBlock Text="25%" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,32" />
                                        <TextBlock Text="0%" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,-2" />
                                    </Grid>

                                    <!-- 波形画布 -->
                                    <Grid Grid.Column="1" VerticalAlignment="Stretch">
                                        <!-- 水平虚线网格 -->
                                        <Border Height="1" BorderBrush="#152438" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                                        <Border Height="1" BorderBrush="#152438" BorderThickness="0,1,0,0" VerticalAlignment="Top" Margin="0,36,0,0" />
                                        <Border Height="1" BorderBrush="#152438" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                                        <Border Height="1" BorderBrush="#152438" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" Margin="0,0,0,36" />
                                        <Border Height="1" BorderBrush="#152438" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" />

                                        <!-- 面积填充 Path -->
                                        <Path x:Name="GpuTrendAreaPath" Stretch="Fill" Fill="{StaticResource GpuTrendAreaGradientBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                                        <!-- 波形折线 Path -->
                                        <Path x:Name="GpuTrendWavePath" Stretch="Fill" Stroke="#00F29D" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    </Grid>
                                </Grid>

                                <!-- X 轴刻度文本 -->
                                <Grid Grid.Row="2" Margin="38,6,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="60s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="50s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="2" Text="40s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="3" Text="30s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="4" Text="20s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="5" Text="10s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="6" Text="0s" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="10" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- 底部 3 组微型统计卡片 -->
                                <Grid Grid.Row="3" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 平均使用率 -->
                                    <Border Grid.Column="0" Background="#09111E" BorderBrush="#142133" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <Grid>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="平均使用率" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" />
                                                <TextBlock x:Name="GpuAvgUsageText" Text="68%" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" />
                                            </StackPanel>
                                            <!-- 发光微缩均衡器图标 -->
                                            <StackPanel Orientation="Horizontal" Spacing="2.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="2.5" Height="8" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="14" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="10" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="18" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 峰值使用率 -->
                                    <Border Grid.Column="1" Background="#09111E" BorderBrush="#142133" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <Grid>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="峰值使用率" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" />
                                                <TextBlock x:Name="GpuPeakUsageText" Text="92%" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="2.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="2.5" Height="12" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="18" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="14" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="20" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 最低使用率 -->
                                    <Border Grid.Column="2" Background="#09111E" BorderBrush="#142133" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <Grid>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="最低使用率" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" />
                                                <TextBlock x:Name="GpuMinUsageText" Text="28%" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="2.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Border Width="2.5" Height="6" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="10" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="8" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                                <Border Width="2.5" Height="12" CornerRadius="1" Background="#00F29D" VerticalAlignment="Bottom" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 4. 底部: 性能调节 (Performance Tuning) -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="性能调节" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="自定义显卡运行参数，打造专属游戏体验" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" Margin="14,2,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="GpuTuningStatusText" Foreground="{StaticResource GpuAccentBlueBrush}" FontSize="12" Margin="14,2,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 3 张调节卡片 Grid -->
                        <Grid x:Name="GpuControlGrid" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 卡片 1: 显卡频率锁定 -->
                            <Border x:Name="GpuCoreFrequencyPanel" Grid.Column="0" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="显卡频率锁定" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="GpuCoreFrequencyToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="OnGpuTuningToggleChanged" />
                                    </Grid>

                                    <!-- 滑块与输入框行 -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GpuFrequencyLimitSlider" Grid.Column="0" Minimum="1000" Maximum="3000" Value="2550" StepFrequency="25" IsThumbToolTipEnabled="False" Foreground="{StaticResource GpuAccentBlueBrush}" VerticalAlignment="Center" ValueChanged="OnGpuFrequencySliderChanged" />
                                        <TextBox x:Name="GpuFrequencyLimitBox" Grid.Column="1" Text="2550" Width="66" Height="30" CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#080E18" Foreground="#FFFFFF" BorderBrush="#1C2C40" BorderThickness="1" FontSize="13" FontWeight="SemiBold" Padding="0" />
                                        <TextBlock Grid.Column="2" Text="MHz" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 标尺刻度 -->
                                    <Grid Margin="0,-4,0,0">
                                        <TextBlock Text="1000" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Left" />
                                        <TextBlock Text="3000" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,100,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片 2: 显存频率固定 -->
                            <Border x:Name="GpuMemoryFrequencyPanel" Grid.Column="1" Background="{StaticResource GpuCardBgBrush}" BorderBrush="{StaticResource GpuCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="显存频率固定" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="GpuMemoryFrequencyToggle" IsOn="True" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="OnGpuTuningToggleChanged" />
                                    </Grid>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="GpuMemoryFrequencySlider" Grid.Column="0" Minimum="4000" Maximum="12000" Value="8400" StepFrequency="50" IsThumbToolTipEnabled="False" Foreground="{StaticResource GpuAccentBlueBrush}" VerticalAlignment="Center" ValueChanged="OnGpuMemoryFrequencySliderChanged" />
                                        <TextBox x:Name="GpuMemoryFrequencyBox" Grid.Column="1" Text="8400" Width="66" Height="30" CornerRadius="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#080E18" Foreground="#FFFFFF" BorderBrush="#1C2C40" BorderThickness="1" FontSize="13" FontWeight="SemiBold" Padding="0" />
                                        <TextBlock Grid.Column="2" Text="MHz" Foreground="{StaticResource GpuTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,-4,0,0">
                                        <TextBlock Text="4000" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Left" />
                                        <TextBlock Text="12000" Foreground="{StaticResource GpuTextMutedBrush}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,100,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </Grid>

                        <!-- 右下角操作按钮组 (重置 与 应用) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,4,0,0">
                            <Button x:Name="GpuResetButton" Click="OnGpuResetClick" Content="重置" Background="{StaticResource ControlButtonNeutralBrush}" Foreground="#98A9BD" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="26,8" FontSize="13" FontWeight="Medium" />
                            <Button x:Name="GpuApplyButton" Click="OnGpuApplyClick" Content="应用" Background="{StaticResource GpuAccentBlueBrush}" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="8" Padding="28,8" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
<Grid x:Name="FanPage" Visibility="Collapsed" AutomationProperties.AutomationId="Page.Fan">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部 Header：标题与模式/预设操作 -->
            <Grid x:Name="LegacyFanHeader" Grid.Row="0" ColumnSpacing="14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="124" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/Icons/NavFanFilled.svg" Width="22" Height="22" />
                        </Border>
                        <TextBlock Text="风扇控制台" Foreground="{StaticResource PrototypeTextBrush}" FontSize="31" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="双涡轮气流动力学、实时转速遥测与高纵横比坐标温控工作站" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="15" Margin="44,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PerformanceMenuButtonStyle}" Content="预设操作" Width="112" Height="46" VerticalAlignment="Center" AutomationProperties.Name="风扇预设操作">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="保存当前风扇预设" Click="OnSaveFanPresetClick" />
                            <MenuFlyoutItem Text="还原默认风扇预设" Click="OnRestoreFanPresetClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="2" Width="112" Height="46" Style="{StaticResource PerformanceMenuButtonStyle}" Content="预设 1" VerticalAlignment="Center" AutomationProperties.Name="选择当前风扇预设">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="预设 1" Tag="0" />
                            <MenuFlyoutItem Text="预设 2" Tag="1" />
                            <MenuFlyoutItem Text="预设 3" Tag="2" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="3" Width="124" Height="46" Style="{StaticResource PerformanceMenuButtonStyle}" Content="办公" VerticalAlignment="Center" AutomationProperties.Name="选择当前模式">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="办公" Tag="office" />
                            <MenuFlyoutItem Text="游戏" Tag="game" />
                            <MenuFlyoutItem Text="狂飙" Tag="turbo" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- 主内容滚动区 -->
            <ScrollViewer x:Name="LegacyFanContent" Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <!-- 主视觉 1: 双涡轮气流动力学与看门狗联锁中枢 (3 个平级面板，禁止卡片嵌套) -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左涡轮: CPU 散热气流动力学单元 -->
                        <Border Grid.Column="0" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 标题与状态 -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="C" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="处理器涡轮 (CPU Fan)" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="侧出风口 · 79 密集超薄叶片" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#FF42E6AE" BorderThickness="1" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="运行中" Foreground="#FF42E6AE" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- 实时数据大看板与气流矢量 -->
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="实时转速" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
                                        <TextBlock x:Name="CpuFanText" Text="-- RPM" Foreground="{StaticResource PrototypeTextBrush}" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="‹‹ 进风" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="核心温度" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="FanCpuTemperatureText" Text="-- °C" Foreground="{StaticResource PrototypeTextBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- 转速柱状进度与量程 -->
                                <StackPanel Grid.Row="2" Spacing="4">
                                    <ProgressBar x:Name="FanCpuMeter" Maximum="6000" Value="0" Height="8" Foreground="{StaticResource ModeMeterGradientBrush}" Background="{StaticResource PrototypeTrackBrush}" CornerRadius="4" />
                                    <Grid>
                                        <TextBlock Text="0 RPM" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="10" />
                                        <TextBlock Text="3000" HorizontalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="10" />
                                        <TextBlock Text="6000 RPM" HorizontalAlignment="Right" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="10" />
                                    </Grid>
                                </StackPanel>

                                <!-- 温度指示器 -->
                                <ProgressBar x:Name="FanCpuTempMeter" Grid.Row="3" Maximum="100" Value="0" Height="3" Foreground="{StaticResource ModeAccentBrush}" Background="{StaticResource PrototypeTrackBrush}" CornerRadius="2" Opacity="0.5" />
                            </Grid>
                        </Border>

                        <!-- 中枢: 控制权归属与看门狗联锁 (Watchdog & Interlock Hub - 扁平独立面板无内套卡片) -->
                        <Border Grid.Column="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <StackPanel Spacing="10" VerticalAlignment="Center">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="控制权与安全联锁" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="?" Style="{StaticResource PerformanceInfoButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="看门狗安全联锁说明">
                                            <ToolTipService.ToolTip>
                                                <ToolTip>
                                                    <StackPanel Width="340" Spacing="4">
                                                        <TextBlock Text="看门狗与硬件安全联锁 (Watchdog Interlock)" FontWeight="SemiBold" />
                                                        <TextBlock Text="作用：服务检查温度与控制状态，异常时把风扇交还 EC。推荐：保留联锁。保守：保持 EC 自动。极限：联锁不是可提高的性能参数，不能替代本机散热验证。" TextWrapping="Wrap" />
                                                        <TextBlock Text="当前软件保护：CPU 达 95°C 或 GPU 达 87°C 释放控制，交回 EC；这是软件控制阈值，不是硬件安全温度保证。" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="EC 闭环" Foreground="{StaticResource ModeAccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- 看门狗核心指标 (扁平排版) -->
                                <StackPanel Spacing="3" Margin="0,2,0,2">
                                    <TextBlock Text="3.0s 超时防线" Foreground="#FF42E6AE" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="双路温度联锁：CPU≥95°C / GPU≥87°C 立即强制释放回 EC" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 双风扇同步联动开关 -->
                                <ToggleSwitch x:Name="FanSyncToggle" Header="双风扇转速联动同步" IsOn="True" OnContent="已同步" OffContent="独立" Style="{StaticResource PrototypeModeToggleSwitchStyle}" AutomationProperties.Name="双风扇联动开关" />
                            </StackPanel>
                        </Border>

                        <!-- 右涡轮: GPU 散热气流动力学单元 -->
                        <Border Grid.Column="2" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 标题与状态 -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="G" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="独立显卡涡轮 (GPU Fan)" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="后出风口 · 纯铜双热管均热板直通" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#FF42E6AE" BorderThickness="1" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                        <TextBlock Text="运行中" Foreground="#FF42E6AE" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- 实时数据大看板与气流矢量 -->
                                <Grid Grid.Row="1" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="实时转速" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" />
                                        <TextBlock x:Name="GpuFanText" Text="-- RPM" Foreground="{StaticResource PrototypeTextBrush}" FontSize="24" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="出风 ››" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="核心温度" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock x:Name="FanGpuTemperatureText" Text="-- °C" Foreground="{StaticResource PrototypeTextBrush}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>

                                <!-- 转速柱状进度与量程 -->
                                <StackPanel Grid.Row="2" Spacing="4">
                                    <ProgressBar x:Name="FanGpuMeter" Maximum="6000" Value="0" Height="8" Foreground="{StaticResource ModeMeterGradientBrush}" Background="{StaticResource PrototypeTrackBrush}" CornerRadius="4" />
                                    <Grid>
                                        <TextBlock Text="0 RPM" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="10" />
                                        <TextBlock Text="3000" HorizontalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="10" />
                                        <TextBlock Text="6000 RPM" HorizontalAlignment="Right" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="10" />
                                    </Grid>
                                </StackPanel>

                                <!-- 温度指示器 -->
                                <ProgressBar x:Name="FanGpuTempMeter" Grid.Row="3" Maximum="100" Value="0" Height="3" Foreground="{StaticResource ModeAccentBrush}" Background="{StaticResource PrototypeTrackBrush}" CornerRadius="2" Opacity="0.5" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 主视觉 2: 高纵横比专业温控曲线工作站 (High-Aspect Coordinate Studio) -->
                    <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel Spacing="16">
                            <!-- 面板标题与状态 -->
                            <Grid>
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="温度 - 转速动态坐标工作站" Foreground="{StaticResource PrototypeTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="高精度曲线" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="六点曲线调校矩阵，严守单调递增合规校验与 95°C 硬件熔断红线。" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="13" />
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,5">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="6" Height="6" Fill="#FF42E6AE" VerticalAlignment="Center" />
                                        <TextBlock Text="模拟算法验证就绪" Foreground="{StaticResource PrototypeTextBrush}" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 控制策略选择与固定目标快捷栏 -->
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <!-- 策略来源 -->
                                <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="控制来源" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Content="?" Style="{StaticResource PerformanceInfoButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="控制来源说明">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel Width="320" Spacing="4">
                                                            <TextBlock Text="风扇调控模式说明" FontWeight="SemiBold" />
                                                            <TextBlock Text="作用：EC 自动交由主板调速；固定目标保持指定转速；温度曲线随温度改变目标。推荐：日常 EC 自动或当前模式推荐曲线。保守：保留已有稳定策略。极限：这些是控制方式，没有通用数值极限；实际转速以回读为准。" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <ComboBox x:Name="FanModeBox" Grid.Column="1" SelectedIndex="3" Background="{StaticResource PrototypeControlAcrylicBrush}" Foreground="{StaticResource PrototypeTextBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" AutomationProperties.Name="风扇控制来源">
                                            <ComboBoxItem Content="EC 自动" />
                                            <ComboBoxItem Content="官方预设 (静音/均衡/强效)" />
                                            <ComboBoxItem Content="固定目标 (20–100%)" />
                                            <ComboBoxItem Content="温度曲线 (六点阶梯)" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- 固定目标转速微调 -->
                                <Border Grid.Column="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="固定转速" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Content="?" Style="{StaticResource PerformanceInfoButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="固定转速说明">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel Width="320" Spacing="4">
                                                            <TextBlock Text="固定目标转速 (Fixed Fan Target)" FontWeight="SemiBold" />
                                                            <TextBlock Text="作用：指定固定风扇目标，提高通常更凉、更吵，降低可能升温。推荐：优先 EC 自动。保守：保留已验证策略，调整后观察温度。极限：输入边界仅是软件范围，不代表失速阈值；高温时由保护交还 EC，不保证固定实际 RPM。" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </ToolTipService.ToolTip>
                                            </Button>
                                        </StackPanel>
                                        <Slider x:Name="FanTargetSlider" Grid.Column="1" Minimum="20" Maximum="100" Value="60" StepFrequency="5" Style="{StaticResource PerformanceSliderStyle}" VerticalAlignment="Center" AutomationProperties.Name="固定目标转速滑动条" />
                                        <NumberBox x:Name="FanTargetBox" Grid.Column="2" Value="60" Minimum="20" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" VerticalAlignment="Center" Width="76" Height="34" FontSize="14" />
                                        <TextBlock Grid.Column="3" Text="%" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="14" VerticalAlignment="Center" FontWeight="Medium" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 高比例坐标图 (High-Aspect Coordinate Canvas: 340px+ Height) -->
                            <Border Background="#CC070A0F" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="20,16">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="340" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 坐标系说明与图例 -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Line X1="0" Y1="0" X2="16" Y2="0" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3" VerticalAlignment="Center" />
                                                <TextBlock Text="阶梯转速目标曲线" Foreground="{StaticResource PrototypeTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Line X1="0" Y1="0" X2="16" Y2="0" Stroke="#FFFF4D4F" StrokeThickness="2" StrokeDashArray="3,2" VerticalAlignment="Center" />
                                                <TextBlock Text="95°C 熔断安全防线" Foreground="#FFFF4D4F" FontSize="12" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Line X1="0" Y1="0" X2="16" Y2="0" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="1" StrokeDashArray="4,4" VerticalAlignment="Center" />
                                                <TextBlock Text="20% 最低起旋基线" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="纵轴: 目标转速百分比与对应转速 (RPM)　|　横轴: 芯片核心温度 (°C)" HorizontalAlignment="Right" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 340px 高纵横比坐标主绘图画布 -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Y 轴刻度标签 (0% - 100%) -->
                                        <Grid Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="100% (6000)" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                            <TextBlock Text="80% (4800)" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" Margin="0,64,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                            <TextBlock Text="60% (3600)" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" Margin="0,132,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                            <TextBlock Text="40% (2400)" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" Margin="0,200,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                            <TextBlock Text="20% (1200)" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" Margin="0,268,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                            <TextBlock Text="0% (0)" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                                        </Grid>

                                        <!-- 坐标绘图区域 (网格、安全红线、曲线与控制点) -->
                                        <Viewbox Grid.Column="1" Stretch="Fill">
                                            <Canvas Width="1000" Height="340">
                                                <!-- 水平网格线 (转速刻度) -->
                                                <Line X1="0" Y1="10" X2="1000" Y2="10" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="0" Y1="74" X2="1000" Y2="74" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="0" Y1="142" X2="1000" Y2="142" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="0" Y1="210" X2="1000" Y2="210" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="0" Y1="278" X2="1000" Y2="278" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="0" Y1="330" X2="1000" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="1" />

                                                <!-- 垂直温度网格线 (30°C - 100°C) -->
                                                <Line X1="142" Y1="0" X2="142" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="285" Y1="0" X2="285" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="428" Y1="0" X2="428" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="571" Y1="0" X2="571" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="714" Y1="0" X2="714" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />
                                                <Line X1="857" Y1="0" X2="857" Y2="330" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="0.8" StrokeDashArray="4,4" />

                                                <!-- 95°C 熔断防线 (X=928) -->
                                                <Line X1="928" Y1="0" X2="928" Y2="330" Stroke="#FFFF4D4F" StrokeThickness="2" StrokeDashArray="4,3" />

                                                <!-- 曲线渐变填充区 -->
                                                <Path Data="M 142,278 L 285,244 L 428,210 L 571,159 L 714,91 L 857,10 L 928,10 L 1000,10 L 1000,330 L 142,330 Z" Fill="{StaticResource PrototypeTrackBrush}" Opacity="0.35" />

                                                <!-- 矢量平滑连接线 -->
                                                <Path Data="M 0,278 L 142,278 C 213,278 214,244 285,244 C 356,244 357,210 428,210 C 499,210 500,159 571,159 C 642,159 643,91 714,91 C 785,91 786,10 857,10 L 1000,10" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="4" Fill="Transparent" />

                                                <!-- 6 个交互节点 (温度-转速同步点) -->
                                                <!-- P1: 40°C, 20% (X=142, Y=278) -->
                                                <Ellipse Width="14" Height="14" Canvas.Left="135" Canvas.Top="271" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3.5" />
                                                <!-- P2: 50°C, 30% (X=285, Y=244) -->
                                                <Ellipse Width="14" Height="14" Canvas.Left="278" Canvas.Top="237" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3.5" />
                                                <!-- P3: 60°C, 40% (X=428, Y=210) -->
                                                <Ellipse Width="14" Height="14" Canvas.Left="421" Canvas.Top="203" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3.5" />
                                                <!-- P4: 70°C, 55% (X=571, Y=159) -->
                                                <Ellipse Width="14" Height="14" Canvas.Left="564" Canvas.Top="152" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3.5" />
                                                <!-- P5: 80°C, 75% (X=714, Y=91) -->
                                                <Ellipse Width="14" Height="14" Canvas.Left="707" Canvas.Top="84" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3.5" />
                                                <!-- P6: 90°C, 100% (X=857, Y=10) -->
                                                <Ellipse Width="14" Height="14" Canvas.Left="850" Canvas.Top="3" Fill="{StaticResource PrototypeTextBrush}" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3.5" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>

                                    <!-- X 轴温度刻度标签 (30°C - 100°C) -->
                                    <Grid Grid.Row="2" Margin="68,4,0,0">
                                        <TextBlock Text="30 °C" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" HorizontalAlignment="Left" />
                                        <TextBlock Text="40 °C (P1)" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="115,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="50 °C (P2)" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="258,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="60 °C (P3)" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="401,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="70 °C (P4)" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="544,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="80 °C (P5)" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="687,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="90 °C (P6)" Foreground="{StaticResource ModeAccentBrush}" FontSize="11" FontWeight="SemiBold" Margin="830,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="95 °C 熔断" Foreground="#FFFF4D4F" FontSize="11" FontWeight="SemiBold" Margin="900,0,0,0" HorizontalAlignment="Left" />
                                        <TextBlock Text="100 °C" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 六点数值矩阵微调表 (6 列平铺，带节点坐标同步) -->
                            <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="六点曲线节点矩阵 (单调递增合规)" Foreground="{StaticResource PrototypeTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="温度每步最低 +5°C，转速不可倒退" HorizontalAlignment="Right" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- P1 -->
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="节点 1" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <NumberBox Value="40" Minimum="30" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="温度 (°C)" />
                                            <NumberBox Value="20" Minimum="0" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="转速 (%)" />
                                        </StackPanel>
                                        <!-- P2 -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="节点 2" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <NumberBox Value="50" Minimum="30" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="温度 (°C)" />
                                            <NumberBox Value="30" Minimum="0" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="转速 (%)" />
                                        </StackPanel>
                                        <!-- P3 -->
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="节点 3" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <NumberBox Value="60" Minimum="30" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="温度 (°C)" />
                                            <NumberBox Value="40" Minimum="0" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="转速 (%)" />
                                        </StackPanel>
                                        <!-- P4 -->
                                        <StackPanel Grid.Column="3" Spacing="4">
                                            <TextBlock Text="节点 4" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <NumberBox Value="70" Minimum="30" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="温度 (°C)" />
                                            <NumberBox Value="55" Minimum="0" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="转速 (%)" />
                                        </StackPanel>
                                        <!-- P5 -->
                                        <StackPanel Grid.Column="4" Spacing="4">
                                            <TextBlock Text="节点 5" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <NumberBox Value="80" Minimum="30" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="温度 (°C)" />
                                            <NumberBox Value="75" Minimum="0" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="转速 (%)" />
                                        </StackPanel>
                                        <!-- P6 -->
                                        <StackPanel Grid.Column="5" Spacing="4">
                                            <TextBlock Text="节点 6" Foreground="{StaticResource ModeAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <NumberBox Value="90" Minimum="30" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="温度 (°C)" />
                                            <NumberBox Value="100" Minimum="0" Maximum="100" Style="{StaticResource PerformanceAdvancedNumberBoxStyle}" Width="NaN" Height="36" FontSize="14" HorizontalAlignment="Stretch" Header="转速 (%)" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 动作底栏与安全释放按钮 -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 释放回 EC 自动控制按钮 -->
                                <Button Content="释放为 EC 自动控制" Click="OnFanRelease" Height="44" Padding="18,0" Background="{StaticResource PrototypeControlAcrylicBrush}" Foreground="#FF85C2FF" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="12" FontWeight="SemiBold" AutomationProperties.Name="释放风扇控制" />

                                <TextBlock x:Name="FanStatusText" Text="等待服务回读" Grid.Column="1" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" Margin="18,0" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                    <Button Content="算法模拟预览" Click="OnFanPreview" Height="44" Padding="18,0" Background="{StaticResource PrototypeControlAcrylicBrush}" Foreground="{StaticResource PrototypeTextBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="12" FontWeight="SemiBold" AutomationProperties.Name="预览风扇曲线" />
                                    <Button Content="应用风扇策略" Click="OnFanApply" Height="44" Padding="24,0" Background="{StaticResource ModeSelectionBrush}" Foreground="White" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="12" FontWeight="SemiBold" AutomationProperties.Name="应用风扇策略" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <local:FanWorkspaceV2 x:Name="FanWorkspace" Grid.RowSpan="2" />
        </Grid>
        <Grid x:Name="LightingPage" Visibility="Collapsed" AutomationProperties.AutomationId="Page.Lighting">
            <local:LightingWorkspaceV2 x:Name="LightingWorkspace" />
        </Grid>

        <Grid x:Name="AutomationPage" Visibility="Collapsed" AutomationProperties.AutomationId="Page.Automation">
            <local:AutomationWorkspaceV2 x:Name="AutomationWorkspace" />
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed" AutomationProperties.AutomationId="Page.Settings">
            <Grid.RowDefinitions>
                <RowDefinition Height="126" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部 Header -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="设置" Foreground="{StaticResource PrototypeTextBrush}" FontSize="31" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="调整日常使用偏好，管理快捷菜单与本机运行状态" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="15" />
                </StackPanel>
                <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="14" Padding="14,8" HorizontalAlignment="Right" VerticalAlignment="Center">
