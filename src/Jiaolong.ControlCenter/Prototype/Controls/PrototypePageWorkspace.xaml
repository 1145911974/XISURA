                                </Button>
                                <Grid x:Name="SettingsProjectSupportContentHost" Height="0" Visibility="Collapsed">
                                    <Border x:Name="SettingsProjectSupportContent" Background="Transparent" Padding="20,0,20,18">
                                        <StackPanel Spacing="16">
                                            <Rectangle Height="1" Fill="{StaticResource PrototypeDividerBrush}" />
                                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel Spacing="5" VerticalAlignment="Center"><TextBlock Text="项目主页" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="查看软件介绍、更新与使用说明" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                                <Button Grid.Column="1" Content="打开项目主页" Click="OnOpenProjectHomepage" CornerRadius="12" Height="40" Padding="14,0" Style="{StaticResource ControlGlassButtonStyle}" AutomationProperties.Name="打开 XISURA 项目主页" />
                                            </Grid>
                                            <TextBlock Text="如果喜欢这款软件可以奖励作者一下" FontSize="15" TextWrapping="Wrap" />
                                            <Image x:Name="SettingsDonationImage" Source="ms-appx:///Assets/Support/Donation.jpg" MaxWidth="480" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="作者赞赏码，支付宝与微信支付" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
