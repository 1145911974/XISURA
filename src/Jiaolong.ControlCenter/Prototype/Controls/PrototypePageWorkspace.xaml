                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="应用行为" Foreground="{StaticResource PrototypeTextBrush}" FontSize="18" FontWeight="SemiBold" />
                            <Border Height="1" Background="{StaticResource PrototypeDividerBrush}" />
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch x:Name="SettingsStartupToggle" Header="开机自启动" IsOn="False" OnContent="开启" OffContent="关闭" Toggled="OnSettingsStartupToggled" Style="{StaticResource PrototypeModeToggleSwitchStyle}" AutomationProperties.Name="开机启动" />
                                <ToggleSwitch x:Name="SettingsRememberWindowSizeToggle" Grid.Column="1" Header="记住窗口大小" IsOn="False" OnContent="开启" OffContent="关闭" Toggled="OnSettingsRememberWindowSizeToggled" Style="{StaticResource PrototypeModeToggleSwitchStyle}" AutomationProperties.Name="记住窗口大小" />
                            </Grid>
                            <!-- 窗口关闭规则说明行 (纯扁平无嵌套) -->
                            <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="托盘驻留规则" Foreground="{StaticResource ModeAccentBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="关闭窗口后客户端隐藏到托盘；退出客户端后，系统服务继续按负载、温度与供电调度。前台应用及空闲规则需要客户端在线；关闭首页自动开关可停止调度。" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
<Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Grid.Column="1">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="快捷菜单" Foreground="{StaticResource PrototypeTextBrush}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="SettingsQuickMenuSummary" Text="读取快捷菜单配置中" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="主菜单九宫格" Click="OnSettingsEditQuickMenu" Height="36" Padding="12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{StaticResource PrototypeControlAcrylicBrush}" Foreground="{StaticResource ModeAccentBrush}"
                                        BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="10"
                                        AutomationProperties.Name="编辑主菜单九宫格" />
                                <Button Grid.Column="1" Content="快捷台六宫格" Click="OnSettingsEditTrayQuickMenu" Height="36" Padding="12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Background="{StaticResource PrototypeControlAcrylicBrush}" Foreground="{StaticResource ModeAccentBrush}"
                                        BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="10"
                                        AutomationProperties.Name="编辑快捷台六宫格" />
                            </Grid>
                        </Grid>
                    </Border>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}"/>
                                <Border Height="1" Background="{StaticResource PrototypeDividerBrush}"/>
                                <ComboBox x:Name="SettingsLogoStyleSelector" Header="Logo 样式" HorizontalAlignment="Stretch" Style="{StaticResource PerformanceComboBoxStyle}" CornerRadius="10" SelectionChanged="OnSettingsLogoStyleChanged" AutomationProperties.Name="选择 Logo 样式">
                                    <ComboBoxItem Tag="explore">
                                        <StackPanel Orientation="Horizontal" Spacing="12"><Image Source="ms-appx:///Assets/Brand/CModeIcons/JiaolongCOffice-Home.svg" Width="28" Height="28"/><TextBlock Text="探索模式" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="classic">
                                        <StackPanel Orientation="Horizontal" Spacing="12"><Image Source="ms-appx:///Assets/Brand/HeroLogoFullOffice.png" Width="28" Height="28"/><TextBlock Text="经典模式" FontSize="14" VerticalAlignment="Center"/></StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <TextBlock Text="更改后立即显示，并记住下次启动时的选择" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" x:Name="SettingsRuntimeCard" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="20,16">
                        <Grid RowSpacing="14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="运行状态" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="SettingsServiceStatusText" Text="读取中" FontSize="13" VerticalAlignment="Center"/>
