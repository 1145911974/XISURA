<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Prototype.Controls.HomeMonitorGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Jiaolong_ControlCenter.Prototype.Controls"
    xmlns:shared="using:Jiaolong_ControlCenter.Controls"
    Width="729"
    Height="728">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="438" /><RowDefinition Height="272" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
            <controls:MonitorPanel x:Name="CpuMonitorCard" DeviceKind="Cpu" Title="处理器 CPU" IconSource="ms-appx:///Assets/Icons/HomeMonitorCpuFilled.svg" Detail1Label="频率（平滑）" Detail1Value="--" Detail2Label="功耗" Detail2Value="--" />
            <controls:MonitorPanel x:Name="GpuMonitorCard" Grid.Column="1" DeviceKind="Gpu" Title="显卡 GPU" IconSource="ms-appx:///Assets/Icons/HomeMonitorGpuFilled.svg" Detail1Label="显存" Detail1Value="--" Detail2Label="功耗" Detail2Value="--" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16" Padding="18">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="1.05*" /></Grid.ColumnDefinitions>
                <Grid x:Name="MemoryDetail">
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10"><Image Source="ms-appx:///Assets/Icons/HomeMonitorStorageFilled.svg" Width="22" Height="22" /><TextBlock Text="内存" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="MemoryValue" Typography.NumeralAlignment="Tabular" Text="--/-- GB" Foreground="White" FontSize="22" FontWeight="SemiBold" Width="145" HorizontalAlignment="Center" TextAlignment="Center" />
                        <Grid x:Name="MemorySegments" Width="145" Height="62" HorizontalAlignment="Center">
                            <StackPanel x:Name="MemorySegmentBars" Orientation="Horizontal" Spacing="5" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Grid Width="10" Height="34"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="46"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="54"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="48"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="39"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="28"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="42"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="52"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="44"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                                <Grid Width="10" Height="31"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" Opacity="0"><Border Background="#70FFFFFF" Height="1" Margin="2,1,2,0" VerticalAlignment="Top" CornerRadius="1" Opacity="0.28" /></Border></Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Grid x:Name="StorageDetail" Grid.Column="1" BorderBrush="{StaticResource PrototypeDividerBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,0" RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10"><Image Source="ms-appx:///Assets/Icons/HomeMonitorStorageFilled.svg" Width="22" Height="22" /><TextBlock Text="存储" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <Grid Grid.Row="1" RowSpacing="10" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="16" /><RowDefinition Height="22" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="C 盘" Foreground="#D8FFFFFF" FontSize="13" VerticalAlignment="Center" /><TextBlock x:Name="SystemDriveValue" Typography.NumeralAlignment="Tabular" Grid.Column="1" Text="--/-- GB" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="90" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid x:Name="SystemDriveTrack" Grid.Row="1"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Grid x:Name="SystemDriveFill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"><Grid.RenderTransform><ScaleTransform x:Name="SystemDriveFillScale" ScaleX="0" ScaleY="1" /></Grid.RenderTransform><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" /></Grid></Grid>
                        <TextBlock x:Name="SystemDriveRemaining" Grid.Row="2" Text="剩余 -- GB" Foreground="#B8FFFFFF" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="2" RowSpacing="10" VerticalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="16" /><RowDefinition Height="22" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="所有盘" Foreground="#D8FFFFFF" FontSize="13" VerticalAlignment="Center" /><TextBlock x:Name="AllDrivesValue" Typography.NumeralAlignment="Tabular" Grid.Column="1" Text="--/-- GB" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="90" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        <Grid x:Name="AllDrivesTrack" Grid.Row="1"><Border Background="{StaticResource PrototypeTrackBrush}" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="5" /><Grid x:Name="AllDrivesFill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"><Grid.RenderTransform><ScaleTransform x:Name="AllDrivesFillScale" ScaleX="0" ScaleY="1" /></Grid.RenderTransform><Border Background="{StaticResource ModeMeterGradientBrush}" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="5" /></Grid></Grid>
                        <TextBlock x:Name="AllDrivesRemaining" Grid.Row="2" Text="剩余 -- GB" Foreground="#B8FFFFFF" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <Grid x:Name="FanDetail" Grid.Column="2" BorderBrush="{StaticResource PrototypeDividerBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10"><Image Source="ms-appx:///Assets/Icons/HomeMonitorFanFilled.svg" Width="22" Height="22" /><TextBlock Text="风扇" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,6,0,4" Height="78">
                        <Grid x:Name="CpuFanGraph" Height="52" Margin="18,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                            <Path Data="M 0,4 L 170,4 M 0,26 L 170,26 M 0,52 L 170,52" Stroke="#32FFFFFF" StrokeThickness="1" StrokeDashArray="2,7" Stretch="Fill" />
                            <shared:TelemetryCurve x:Name="CpuFanCurve" WindowSeconds="60" MaximumValue="6000" LineBrush="{StaticResource ModeTraceBrush}" AccentBrush="{StaticResource ModeAccentBrush}" AreaBrush="{StaticResource ModeTraceAreaBrush}" />
                        </Grid>
                        <TextBlock Text="CPU 风扇" Foreground="#D8FFFFFF" FontSize="13" />
                        <TextBlock x:Name="CpuFanValue" Typography.NumeralAlignment="Tabular" Text="-- RPM" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="72" TextAlignment="Right" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,0,0" Height="78">
                            <Grid x:Name="GpuFanGraph" Height="52" Margin="18,0" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                <Path Data="M 0,4 L 170,4 M 0,26 L 170,26 M 0,52 L 170,52" Stroke="#32FFFFFF" StrokeThickness="1" StrokeDashArray="2,7" Stretch="Fill" />
                                <shared:TelemetryCurve x:Name="GpuFanCurve" WindowSeconds="60" MaximumValue="6000" LineBrush="{StaticResource ModeTraceBrush}" AccentBrush="{StaticResource ModeAccentBrush}" AreaBrush="{StaticResource ModeTraceAreaBrush}" />
                            </Grid>
                        <TextBlock Text="GPU 风扇" Foreground="#D8FFFFFF" FontSize="13" />
                        <TextBlock x:Name="GpuFanValue" Typography.NumeralAlignment="Tabular" Text="-- RPM" Foreground="White" FontSize="13" FontWeight="SemiBold" Width="72" TextAlignment="Right" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
