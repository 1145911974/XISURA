<UserControl x:Class="Jiaolong_ControlCenter.Prototype.Controls.LightingWorkspaceV2"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Jiaolong_ControlCenter.Prototype.Controls" xmlns:shared="using:Jiaolong_ControlCenter.Controls">
 <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
 <Grid RowSpacing="16" Padding="18,30,18,28">
 <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid><StackPanel VerticalAlignment="Center" Spacing="6"><TextBlock Text="灯光" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource PrototypeTextBrush}"/><TextBlock Text="设置键盘与机身灯光效果" FontSize="14" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/></StackPanel>
 <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
 <shared:PagePresetToolbar x:Name="PresetToolbar" VerticalAlignment="Top"/></StackPanel></Grid>
 <Border Grid.Row="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
 <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <TextBlock Text="设备预览" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
 <TextBlock Grid.Column="1" Text="蛟龙 16 Pro · 2023" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
 <TextBlock Grid.Column="2" x:Name="HardwareStatusText" Text="正在读取灯光状态" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
 </Grid>
 <local:LightingKeyboardPreview Grid.Row="1" x:Name="KeyboardPreview" Height="364" AutomationProperties.Name="实机键盘布局预览，整把键盘统一颜色"/>
 </Grid></Border>
 <ContentControl Grid.Row="2" x:Name="EditorHost" HorizontalContentAlignment="Stretch"><Grid x:Name="EditorGrid" ColumnSpacing="16">
 <Grid.ColumnDefinitions><ColumnDefinition Width="1.02*"/><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
 <Border Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
 <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="灯效与亮度" FontSize="22" FontWeight="SemiBold"/><shared:ParameterHelpButton x:Name="EffectHelp" ParameterName="灯效规则"/></StackPanel>
 <Grid Grid.Row="1" ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
 <ToggleButton x:Name="StaticButton" Content="常亮" Height="42" HorizontalAlignment="Stretch" Style="{StaticResource ControlGlassToggleStyle}" Click="OnEffectClick" Tag="Static"/>
 <ToggleButton Grid.Column="1" x:Name="GradientButton" Content="渐变" Height="42" HorizontalAlignment="Stretch" IsChecked="True" Style="{StaticResource ControlGlassToggleStyle}" Click="OnEffectClick" Tag="Gradient"/>
 <ToggleButton Grid.Column="2" x:Name="CycleButton" Content="循环" Height="42" HorizontalAlignment="Stretch" Style="{StaticResource ControlGlassToggleStyle}" Click="OnEffectClick" Tag="Cycle"/></Grid>
 <StackPanel Grid.Row="2" Spacing="10"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="亮度" VerticalAlignment="Center"/><shared:ParameterHelpButton x:Name="BrightnessHelp" ParameterName="键盘亮度"/></StackPanel>
 <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="3" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" Value="2" ValueChanged="OnBrightnessChanged" AutomationProperties.Name="键盘亮度，0 关闭，1 低，2 中，3 高"><Slider.Resources><x:Double x:Key="SliderTrackThemeHeight">8</x:Double></Slider.Resources></Slider>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="关闭" FontSize="12"/><TextBlock Grid.Column="1" Text="低" HorizontalAlignment="Center" FontSize="12"/><TextBlock Grid.Column="2" Text="中" HorizontalAlignment="Center" FontSize="12"/><TextBlock Grid.Column="3" Text="高" HorizontalAlignment="Right" FontSize="12"/></Grid></StackPanel>
 <StackPanel Grid.Row="3" Spacing="4"><Grid><TextBlock Text="变色速度"/><TextBlock x:Name="SpeedValueText" Text="1×" HorizontalAlignment="Right" FontFamily="Consolas"/></Grid>
 <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2" StepFrequency="0.25" Value="1" ValueChanged="OnSpeedChanged" AutomationProperties.Name="变色速度，0.5 至 2 倍"><Slider.Resources><x:Double x:Key="SliderTrackThemeHeight">8</x:Double></Slider.Resources></Slider>
 <Grid><TextBlock Text="慢 · 0.5×" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><TextBlock Text="快 · 2×" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/></Grid></StackPanel>
 <TextBlock Grid.Row="4" Text="整把键盘统一变色" VerticalAlignment="Bottom" Foreground="{StaticResource PrototypeSecondaryTextBrush}" FontSize="12" Margin="0,4,0,0"/>
 </Grid></Border>
 <Border Grid.Column="1" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
 <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid><TextBlock Text="灯光颜色" FontSize="22" FontWeight="SemiBold"/><Button Content="恢复默认" HorizontalAlignment="Right" Padding="10,3" FontSize="12" Click="OnResetClick" ToolTipService.ToolTip="管理预设时恢复编辑默认值；日常页面恢复默认灯光并直接生效"/></Grid>
 <ContentControl Grid.Row="1" x:Name="ColorEditorHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid x:Name="ColorEditor" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
 <local:LightingColorWheel x:Name="ColorWheel" Height="216" VerticalAlignment="Center" AutomationProperties.Name="色环与饱和度明度选区；也可使用右侧 HEX 和 RGB 输入"/>
 <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
 <TextBox x:Name="HexInput" Text="#00D7E8" FontFamily="Consolas" MaxLength="7" Height="38" LostFocus="OnHexCommit" KeyDown="OnHexKeyDown" AutomationProperties.Name="十六进制颜色"/>
 <Grid ColumnSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
 <StackPanel Spacing="5"><TextBlock Text="R" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><shared:GpuValueStepper x:Name="RedInput" Width="Auto" HorizontalAlignment="Stretch" Minimum="0" Maximum="255" ValueChanged="OnRgbChanged" AutomationProperties.Name="红色分量"/></StackPanel>
 <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="G" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><shared:GpuValueStepper x:Name="GreenInput" Width="Auto" HorizontalAlignment="Stretch" Minimum="0" Maximum="255" ValueChanged="OnRgbChanged" AutomationProperties.Name="绿色分量"/></StackPanel>
 <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="B" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/><shared:GpuValueStepper x:Name="BlueInput" Width="Auto" HorizontalAlignment="Stretch" Minimum="0" Maximum="255" ValueChanged="OnRgbChanged" AutomationProperties.Name="蓝色分量"/></StackPanel></Grid>
 <ContentControl x:Name="SwatchesHost" HorizontalContentAlignment="Stretch"><Grid x:Name="Swatches" ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid></ContentControl>
 </StackPanel></Grid></ContentControl></Grid></Border>
 <Border Grid.Column="2" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="{StaticResource PrototypeStrokeBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
 <Grid RowSpacing="10" ColumnSpacing="12">
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <TextBlock Grid.ColumnSpan="2" Text="标志与恢复" FontSize="22" FontWeight="SemiBold"/>
 <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
 <FontIcon Glyph="&#xE7F8;" FontSize="28" VerticalAlignment="Center"/>
 <StackPanel Spacing="5"><TextBlock Text="A 面标志" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="仅支持开关" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/></StackPanel></StackPanel>
 <ToggleSwitch Grid.Row="1" Grid.Column="1" x:Name="LogoToggle" IsOn="True" Toggled="OnLogoChanged" OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrototypeModeToggleSwitchStyle}" AutomationProperties.Name="A 面标志"/>
 <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Height="1" Fill="{StaticResource PrototypeDividerBrush}"/>
 <StackPanel Grid.Row="3" Spacing="5" VerticalAlignment="Center"><TextBlock Text="启动时恢复" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="恢复上次成功应用的设置" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/></StackPanel>
 <TextBlock Grid.Row="3" Grid.Column="1" Text="自动" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/>
 <StackPanel Grid.Row="4" Spacing="5" VerticalAlignment="Center"><TextBlock Text="唤醒后恢复" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="唤醒后恢复已使用灯效" FontSize="12" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/></StackPanel>
 <TextBlock Grid.Row="4" Grid.Column="1" Text="自动" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PrototypeSecondaryTextBrush}"/>
 </Grid></Border>
 </Grid></ContentControl></Grid></ScrollViewer>
</UserControl>
