                <TextBlock Text="目标平台" Canvas.Top="240" FontSize="15" Opacity="0.76" /><TextBlock x:Name="PreviewPointText" Text="--" Canvas.Left="172" Canvas.Top="238" Width="194" TextAlignment="Right" FontSize="16" FontWeight="SemiBold" />
            </Canvas>
            <Canvas x:Name="ManualEditor" Canvas.Left="958" Canvas.Top="78" Width="366" Height="286" Visibility="Collapsed">
                <TextBlock Text="选中电压档位" Canvas.Top="13" FontSize="15" FontWeight="SemiBold" /><shared:GpuValueStepper x:Name="ManualVoltageBox" Canvas.Left="190" Width="138" Height="40" Minimum="450" Maximum="1240" Value="950" RejectOutOfRangeInput="True" SmallChange="5" AutomationProperties.Name="手动选中电压档位" /><TextBlock Text="mV" Canvas.Left="336" Canvas.Top="13" FontSize="14" Opacity="0.76" />
