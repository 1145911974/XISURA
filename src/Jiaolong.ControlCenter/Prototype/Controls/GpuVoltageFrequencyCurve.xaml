            </Canvas>
            <TextBlock x:Name="ReferenceText" Text="" Visibility="Collapsed" Canvas.Left="958" Canvas.Top="377" Width="366" FontSize="12" Opacity="0.64" />
            <Line X1="0" X2="1348" Y1="430" Y2="430" Stroke="#32FFFFFF" /><Ellipse x:Name="CapabilityDot" Canvas.Left="28" Canvas.Top="454" Width="10" Height="10" Fill="#FF59636D" /><TextBlock x:Name="CapabilityStatusText" Text="等待曲线能力回读" Canvas.Left="48" Canvas.Top="446" Width="866" TextTrimming="CharacterEllipsis" FontSize="14" Opacity="0.78" />
            <Button x:Name="RestoreDefaultsButton" Canvas.Left="1202" Canvas.Top="441" Width="112" Height="36" Content="恢复默认" AutomationProperties.Name="恢复默认电压频率曲线" ToolTipService.ToolTip="将核心及曲线各档位的频率偏移恢复为 0 MHz" Click="OnRestoreDefaultsClick" />
        </Canvas></Viewbox>
    </Border>
</UserControl>
