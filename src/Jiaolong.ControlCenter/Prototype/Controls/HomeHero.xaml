<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Prototype.Controls.HomeHero"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:branding="using:Jiaolong_ControlCenter.Branding"
    xmlns:controls="using:Jiaolong_ControlCenter.Prototype.Controls"
    Width="609"
    Height="835">
    <Canvas>
        <Border Canvas.Left="205.5" Canvas.Top="9" Width="198" Height="48" Background="{StaticResource PrototypeControlAcrylicBrush}" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="HeroSelectionPlate" Grid.ColumnSpan="2" Width="97" Height="44" HorizontalAlignment="Left" Background="{StaticResource ModeSelectionBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="9"><Border.RenderTransform><TranslateTransform x:Name="HeroSelectionTransform" /></Border.RenderTransform></Border>
                <controls:PrototypeButton x:Name="LogoViewButton" Grid.Column="0" MinWidth="0" Height="48" Padding="0" HorizontalAlignment="Stretch" Tag="Logo" Click="OnViewClick" Foreground="White" Background="Transparent" BorderThickness="0" CornerRadius="9" AutomationProperties.AutomationId="HeroView.Logo"><TextBlock Text="Logo" Style="{StaticResource PrototypeHeroToggleTextStyle}" /></controls:PrototypeButton>
                <controls:PrototypeButton x:Name="PerformanceViewButton" Grid.Column="1" MinWidth="0" Height="48" Padding="0" HorizontalAlignment="Stretch" Tag="Performance" Click="OnViewClick" Foreground="White" Background="Transparent" BorderThickness="0" CornerRadius="9" AutomationProperties.AutomationId="HeroView.Performance"><TextBlock Text="性能" Style="{StaticResource PrototypeHeroToggleTextStyle}" /></controls:PrototypeButton>
            </Grid>
        </Border>

        <Grid
            x:Name="LogoVisualHost"
            Canvas.Left="{x:Bind LogoProfile.Left, Mode=OneTime}"
            Canvas.Top="{x:Bind LogoProfile.Top, Mode=OneTime}"
            Width="{x:Bind LogoProfile.Size, Mode=OneTime}"
            Height="{x:Bind LogoProfile.Size, Mode=OneTime}"
            RenderTransformOrigin="0.5,0.5"
            AutomationProperties.AutomationId="HeroLogoVisual">
            <Grid.RenderTransform><ScaleTransform x:Name="LogoViewScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
            <branding:HeroLogoControl x:Name="LogoVisual" Profile="{x:Bind LogoProfile, Mode=OneTime}" Visibility="Collapsed" />
            <branding:WaveLogoControl x:Name="WaveLogoVisual" SoftBackground="True" AutomationProperties.Name="蛟龙探索标志" />
        </Grid>
        <Grid
            x:Name="PerformanceRadar"
            Canvas.Left="{x:Bind LogoProfile.Left, Mode=OneTime}"
            Canvas.Top="{x:Bind LogoProfile.Top, Mode=OneTime}"
            Width="{x:Bind LogoProfile.Size, Mode=OneTime}"
            Height="{x:Bind LogoProfile.Size, Mode=OneTime}"
            Opacity="0"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,0.5"
            AutomationProperties.AutomationId="PerformanceRadar">
            <Grid.RenderTransform><ScaleTransform x:Name="RadarViewScale" ScaleX="0.96" ScaleY="0.96" /></Grid.RenderTransform>
            <Viewbox Stretch="Uniform">
                <Canvas Width="360" Height="360">
                    <Canvas x:Name="PerformanceRadarGrid" Width="360" Height="360">
                        <Polygon x:Name="PerformanceRadarShadow" Points="180,76 279,148 241,264 119,264 81,148" Fill="#42000000" Stroke="#A8000000" StrokeThickness="12" />
                        <Polygon x:Name="PerformanceRadarFrost" Points="180,76 279,148 241,264 119,264 81,148" Fill="{StaticResource PrototypeControlAcrylicBrush}" Stroke="{StaticResource PrototypeStrokeBrush}" StrokeThickness="2" />
                        <Polygon Points="180,111 246,159 221,236 139,236 114,159" Fill="Transparent" Stroke="#28FFFFFF" StrokeThickness="1" />
                        <Polygon Points="180,145 213,169 200,208 160,208 147,169" Fill="Transparent" Stroke="#20FFFFFF" StrokeThickness="1" />
                        <Line X1="180" Y1="180" X2="180" Y2="76" Stroke="#28FFFFFF" StrokeThickness="1" />
                        <Line X1="180" Y1="180" X2="279" Y2="148" Stroke="#28FFFFFF" StrokeThickness="1" />
                        <Line X1="180" Y1="180" X2="241" Y2="264" Stroke="#28FFFFFF" StrokeThickness="1" />
                        <Line X1="180" Y1="180" X2="119" Y2="264" Stroke="#28FFFFFF" StrokeThickness="1" />
                        <Line X1="180" Y1="180" X2="81" Y2="148" Stroke="#28FFFFFF" StrokeThickness="1" />
                    </Canvas>
                    <Polygon x:Name="RadarEnergyFill" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="3" StrokeLineJoin="Round">
                        <Polygon.Fill><LinearGradientBrush x:Name="RadarEnergyBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#A867B6FF" Offset="0" /><GradientStop Color="#58225DFF" Offset="0.55" /><GradientStop Color="#B8BCEBFF" Offset="1" /></LinearGradientBrush></Polygon.Fill>
                    </Polygon>

                    <StackPanel Canvas.Left="148" Canvas.Top="18" Width="64" Spacing="1">
                        <TextBlock Text="CPU" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" TextAlignment="Center" />
                        <TextBlock x:Name="CpuValue" Foreground="{StaticResource ModeAccentBrush}" Style="{StaticResource PrototypeRadarValueTextStyle}" TextAlignment="Center" Translation="0,0,8" />
                    </StackPanel>
                    <StackPanel Canvas.Left="286" Canvas.Top="112" Width="68" Spacing="1">
                        <TextBlock Text="GPU" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" TextAlignment="Center" />
                        <TextBlock x:Name="GpuValue" Foreground="{StaticResource ModeAccentBrush}" Style="{StaticResource PrototypeRadarValueTextStyle}" TextAlignment="Center" Translation="0,0,8" />
                    </StackPanel>
                    <StackPanel Canvas.Left="243" Canvas.Top="274" Width="82" Spacing="1">
                        <TextBlock Text="散热" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" TextAlignment="Center" />
                        <TextBlock x:Name="CoolingValue" Foreground="{StaticResource ModeAccentBrush}" Style="{StaticResource PrototypeRadarValueTextStyle}" TextAlignment="Center" Translation="0,0,8" />
                    </StackPanel>
                    <StackPanel Canvas.Left="35" Canvas.Top="274" Width="82" Spacing="1">
                        <TextBlock Text="响应" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" TextAlignment="Center" />
                        <TextBlock x:Name="ResponseValue" Foreground="{StaticResource ModeAccentBrush}" Style="{StaticResource PrototypeRadarValueTextStyle}" TextAlignment="Center" Translation="0,0,8" />
                    </StackPanel>
                    <StackPanel Canvas.Left="6" Canvas.Top="112" Width="68" Spacing="1">
                        <TextBlock Text="静音" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="13" FontWeight="Medium" TextAlignment="Center" />
                        <TextBlock x:Name="QuietValue" Foreground="{StaticResource ModeAccentBrush}" Style="{StaticResource PrototypeRadarValueTextStyle}" TextAlignment="Center" Translation="0,0,8" />
                    </StackPanel>
                </Canvas>
            </Viewbox>
        </Grid>

        <Grid Canvas.Left="72" Canvas.Top="460" Width="465" Height="45"
            IsHitTestVisible="False" AutomationProperties.AutomationId="HeroBrandWordmark"
            AutomationProperties.Name="XISURA">
            <Image Source="ms-appx:///Assets/Brand/XisuraWordmark.svg" Width="218" Height="40" VerticalAlignment="Top" Stretch="Uniform" />
            <Path Data="M 0,0 L 26,0 L 30,-3" Stroke="{StaticResource ModeAccentBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.85" />
        </Grid>

        <StackPanel Canvas.Left="72" Canvas.Top="518" Width="465" HorizontalAlignment="Center" Spacing="8">
            <TextBlock x:Name="CpuModelText" Text="CPU 未知" Foreground="#E8FFFFFF" FontSize="16" FontWeight="Medium" TextAlignment="Center" />
            <TextBlock x:Name="GpuModelText" Text="GPU 未知" Foreground="#E8FFFFFF" FontSize="16" FontWeight="Medium" TextAlignment="Center" />
        </StackPanel>

        <Grid Canvas.Left="225.5" Canvas.Top="610" Width="158" Height="148">
            <controls:PrototypeToggleButton
                x:Name="AutomaticModeButton"
                IsChecked="False"
                Checked="OnAutomaticModeChanged"
                Unchecked="OnAutomaticModeChanged"
                Style="{StaticResource PrototypeStrongCoolingToggleStyle}"
                CornerRadius="28"
                Canvas.ZIndex="1"
                AutomationProperties.AutomationId="AutomaticMode"
                AutomationProperties.Name="自适应模式">
              <Grid Width="158" Height="148">
            <Canvas
                x:Name="AutoModeHaloLayer"
                Width="158"
                Height="148"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Canvas.ZIndex="0"
                IsHitTestVisible="False"
                Opacity="0">
                <Ellipse Width="180" Height="130" Canvas.Left="-30" Canvas.Top="-25" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#B82E7CFF" Offset="0" /><GradientStop Color="#002E7CFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><CompositeTransform x:Name="AutoHalo01Transform" ScaleX="0.72" ScaleY="0.72" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="140" Height="180" Canvas.Left="-35" Canvas.Top="0" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#A02EDCFF" Offset="0" /><GradientStop Color="#002EDCFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><CompositeTransform x:Name="AutoHalo02Transform" ScaleX="0.72" ScaleY="0.72" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="160" Height="110" Canvas.Left="30" Canvas.Top="-30" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#B64B8CFF" Offset="0" /><GradientStop Color="#004B8CFF" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><CompositeTransform x:Name="AutoHalo03Transform" ScaleX="0.72" ScaleY="0.72" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="140" Height="160" Canvas.Left="65" Canvas.Top="20" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#B5FFB33B" Offset="0" /><GradientStop Color="#00FFB33B" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><CompositeTransform x:Name="AutoHalo04Transform" ScaleX="0.72" ScaleY="0.72" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="170" Height="120" Canvas.Left="0" Canvas.Top="70" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#9C45D39A" Offset="0" /><GradientStop Color="#0045D39A" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><CompositeTransform x:Name="AutoHalo05Transform" ScaleX="0.72" ScaleY="0.72" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="150" Height="160" Canvas.Left="-45" Canvas.Top="65" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#A43AD9D8" Offset="0" /><GradientStop Color="#003AD9D8" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.RenderTransform><CompositeTransform x:Name="AutoHalo06Transform" ScaleX="0.72" ScaleY="0.72" /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <Viewbox Width="34" Height="34">
                        <Image Source="ms-appx:///Assets/Icons/NavAutomationFilled.svg" Stretch="Uniform" />
                    </Viewbox>
                    <TextBlock x:Name="AdaptiveModeTitleText" Text="自适应模式" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </controls:PrototypeToggleButton>
            <Border
                x:Name="StrongCoolingAmbientLayer"
                CornerRadius="28"
                IsHitTestVisible="False"
                Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.08,0" EndPoint="0.92,1">
                        <GradientStop Color="#00268AB5" Offset="0" />
                        <GradientStop Color="#5036B8E8" Offset="0.48" />
                        <GradientStop Color="#B25DE3FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border
                x:Name="StrongCoolingFreezeLayer"
                CornerRadius="28"
                IsHitTestVisible="False"
                Opacity="0">
                <Grid>
                    <Image x:Name="StrongCoolingFrame01" Source="ms-appx:///Assets/StrongCooling/Frames/Frame01.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame02" Source="ms-appx:///Assets/StrongCooling/Frames/Frame02.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame03" Source="ms-appx:///Assets/StrongCooling/Frames/Frame03.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame04" Source="ms-appx:///Assets/StrongCooling/Frames/Frame04.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame05" Source="ms-appx:///Assets/StrongCooling/Frames/Frame05.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame06" Source="ms-appx:///Assets/StrongCooling/Frames/Frame06.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame07" Source="ms-appx:///Assets/StrongCooling/Frames/Frame07.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                    <Image x:Name="StrongCoolingFrame08" Source="ms-appx:///Assets/StrongCooling/Frames/Frame08.png" Stretch="UniformToFill" Opacity="0" CacheMode="BitmapCache" />
                </Grid>
            </Border>
        </Grid>
    </Canvas>
</UserControl>
