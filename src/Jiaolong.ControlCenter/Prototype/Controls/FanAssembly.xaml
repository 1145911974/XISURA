<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Jiaolong_ControlCenter.Prototype.Controls.FanAssembly"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Grid Width="512" Height="512">
            <Ellipse x:Name="AmbientHalo" Margin="-12" Opacity="0.65" IsHitTestVisible="False" />
            <Ellipse Margin="30" Fill="#FF090B0F" Stroke="#FF3E434B" StrokeThickness="8" />
            <Ellipse Margin="42" Fill="#FF11141A" Stroke="#FF747A83" StrokeThickness="3" />
            <Ellipse Margin="54" Fill="#FF07090D" Stroke="#FF252A31" StrokeThickness="12" />
            <Ellipse x:Name="GlowRing" Margin="62" Fill="Transparent" StrokeThickness="8" Opacity="0.62" />
            <Ellipse Margin="72" Fill="#FF05070A" Stroke="#FF565C65" StrokeThickness="2" />

            <Viewbox Width="426" Height="426" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
                <Canvas x:Name="RotorSurface" Width="512" Height="512" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><RotateTransform x:Name="RotorRotation" /></Canvas.RenderTransform>
                </Canvas>
            </Viewbox>
            <Ellipse Margin="72" Fill="Transparent" Stroke="#FF686E77" StrokeThickness="3" />

            <Grid x:Name="CenterCap" Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Fill="#FF07090C" />
                <Ellipse Margin="6" Fill="#FF2D3137" Stroke="#FF777D85" StrokeThickness="2" />
                <Ellipse Margin="24" Fill="#FF171A1F" Stroke="#FF555B63" StrokeThickness="2" />
                <Ellipse Margin="38" Fill="#FF2B3036" Opacity="0.72" />
                <Ellipse Margin="48" Fill="#34FFFFFF" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
