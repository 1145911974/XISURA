<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <LinearGradientBrush x:Key="ControlButtonNeutralBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18FFFFFF" Offset="0"/><GradientStop Color="#08080C14" Offset="0.5"/><GradientStop Color="#22000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlButtonAccentBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.62">
        <GradientStop Color="{Binding Color, Source={StaticResource ModeAccentBrush}}" Offset="0"/>
        <GradientStop Color="{Binding Color, Source={StaticResource ModeSelectionAccentBrush}}" Offset="0.55"/>
        <GradientStop Color="{Binding Color, Source={StaticResource ModeAccentBrush}}" Offset="1"/>
    </LinearGradientBrush>
    <AcrylicBrush x:Key="ControlButtonAcrylicBrush" TintColor="#10131B" TintOpacity="0.72" TintLuminosityOpacity="0.30" FallbackColor="#E610131B"/>
    <ControlTemplate x:Key="ControlGlassButtonTemplate" TargetType="primitives:ButtonBase">
        <Grid x:Name="GlassRoot" Background="Transparent">
            <Border Background="{StaticResource ControlButtonAcrylicBrush}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
            <Border x:Name="CheckedTint" Background="{StaticResource ControlButtonAccentBrush}" BorderBrush="{StaticResource ModeAccentBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
            <!-- A low-alpha highlight lifts the existing hue instead of replacing it. -->
            <Border x:Name="InteractionLight" Background="#14FFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualStateGroup.Transitions>
                        <VisualTransition GeneratedDuration="{ThemeResource ControlStateTransitionDuration}">
                            <VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut"/></VisualTransition.GeneratedEasingFunction>
                        </VisualTransition>
                    </VisualStateGroup.Transitions>
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="InteractionLight.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="InteractionLight.Opacity" Value="1"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="GlassRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="CheckedTint.Opacity" Value="1"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="CheckedTint.Opacity" Value="1"/><Setter Target="InteractionLight.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="CheckedTint.Opacity" Value="1"/><Setter Target="InteractionLight.Opacity" Value="1"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="CheckedTint.Opacity" Value="1"/><Setter Target="GlassRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Indeterminate"/>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>
    <Style x:Key="ControlGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Template" Value="{StaticResource ControlGlassButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource ControlButtonNeutralBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ControlGlassButtonStyle}"/>
    <Style x:Key="ControlGlassToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Template" Value="{StaticResource ControlGlassButtonTemplate}"/>
        <Setter Property="Background" Value="{StaticResource ControlButtonNeutralBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrototypeStrokeBrush}"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>

    <StaticResource x:Key="PerformanceV2CardBrush" ResourceKey="PrototypeControlAcrylicBrush" />
    <StaticResource x:Key="PerformanceV2CardBorderBrush" ResourceKey="PrototypeStrokeBrush" />
    <SolidColorBrush x:Key="PerformanceV2AccentBrush" Color="#FFFF2845" />
    <SolidColorBrush x:Key="PerformanceV2MutedTextBrush" Color="#FFB8B6BA" />
    <SolidColorBrush x:Key="PerformanceV2TrackBrush" Color="#FF303034" />
    <CornerRadius x:Key="PerformanceV2CardCornerRadius">16</CornerRadius>
    <ThemeShadow x:Key="PerformanceV2CardShadow" />
    <x:Double x:Key="PerformanceV2TrackHeight">6</x:Double>
    <x:Double x:Key="PerformanceV2ThumbSize">14</x:Double>
    <x:Double x:Key="PerformanceV2InputWidth">98</x:Double>
    <x:Double x:Key="PerformanceV2SectionGap">16</x:Double>
    <Style x:Key="PerformanceV2ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlGlassButtonStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextLineBounds="Tight" VerticalAlignment="Center" HorizontalAlignment="Center"/></DataTemplate></Setter.Value></Setter>
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrototypeTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlButtonNeutralBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ModeAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource ModeAccentBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
    </Style>
    <Style x:Key="PerformanceV2AdvancedButtonStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="AdvancedRoot" Background="Transparent">
                        <!-- Keep the original acrylic brush present in every interaction state. -->
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
                        <Border x:Name="AdvancedHighlight" Background="#0CFFFFFF" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="{ThemeResource ControlStateTransitionDuration}">
                                        <VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut"/></VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="AdvancedHighlight.Opacity" Value="1"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="AdvancedHighlight.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="AdvancedRoot.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="104" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource PerformanceV2CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PerformanceV2CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PerformanceV2CardCornerRadius}" />
    </Style>
</ResourceDictionary>
