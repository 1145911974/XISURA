<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Jiaolong_ControlCenter.Prototype.LogoLabWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:branding="using:Jiaolong_ControlCenter.Branding"
    Title="Jiaolong Logo Lab">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Accept" Label="验证" Click="OnValidateClick" AutomationProperties.Name="验证像素" />
            <AppBarButton x:Name="ExportButton" Icon="Save" Label="导出" Click="OnExportClick" IsEnabled="False" AutomationProperties.Name="验证并导出" />
            <AppBarButton Icon="Refresh" Label="重置" Click="OnResetClick" AutomationProperties.Name="恢复参考值" />
            <AppBarButton Icon="Camera" Label="截取" Click="OnCaptureModesClick" AutomationProperties.Name="截取四模式" />
        </CommandBar>

        <Grid Grid.Row="1" Padding="20" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="ModeSelector" Width="180" Header="模式" SelectedIndex="0" SelectionChanged="OnModeChanged" AutomationProperties.Name="Logo Lab 模式">
                        <ComboBoxItem Content="办公" />
                        <ComboBoxItem Content="游戏" />
                        <ComboBoxItem Content="狂暴" />
                        <ComboBoxItem Content="自定义" />
                    </ComboBox>
                    <ComboBox x:Name="ViewSelector" Width="180" Header="预览视图" SelectedIndex="0" SelectionChanged="OnViewChanged">
                        <ComboBoxItem Content="渲染" />
                        <ComboBoxItem Content="参考" />
                        <ComboBoxItem Content="Overlay 叠加" />
                        <ComboBoxItem Content="Diff 差异" />
                    </ComboBox>
                    <TextBlock x:Name="AdaptiveCoreBadge" Text="自适应核心预览" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,4,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ToggleSwitch x:Name="AdaptiveMotionToggle" Header="动态核心" IsOn="True" Visibility="Collapsed" Toggled="OnAdaptiveMotionToggled" AutomationProperties.Name="自适应核心动画" />
                </StackPanel>

                <Button
                    x:Name="PreviewFocusSurface"
                    Grid.Row="1"
                    Padding="0"
                    Background="Black"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    KeyDown="OnPreviewKeyDown"
                    AutomationProperties.Name="Logo 位置预览">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="Overlay" Width="609" Height="835" Background="Black">
                            <Canvas x:Name="PreviewCanvas" Width="609" Height="835">
                                <branding:HeroLogoControl x:Name="LogoPreview" />
                                <Image x:Name="ReferenceImage" Source="ms-appx:///Assets/Brand/HeroLogoApproved.png" Stretch="Uniform" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Image x:Name="DiffImage" Stretch="Uniform" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            </Canvas>
                        </Grid>
                    </Viewbox>
                </Button>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel Spacing="14">
                    <TextBlock Text="布局与材质" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="预览获得焦点后，方向键移动 1 px；Shift + 方向键移动 10 px。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="X" />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Slider x:Name="LogoXSlider" Minimum="-609" Maximum="609" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Logo X 滑杆" />
                        <NumberBox x:Name="LogoXNumber" Grid.Column="1" Minimum="-609" Maximum="609" SmallChange="1" ValueChanged="OnNumberChanged" AutomationProperties.Name="Logo X" />
                    </Grid>

                    <TextBlock Text="Y" />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Slider x:Name="LogoYSlider" Minimum="-835" Maximum="835" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Logo Y 滑杆" />
                        <NumberBox x:Name="LogoYNumber" Grid.Column="1" Minimum="-835" Maximum="835" SmallChange="1" ValueChanged="OnNumberChanged" AutomationProperties.Name="Logo Y" />
                    </Grid>

                    <TextBlock Text="尺寸" />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Slider x:Name="LogoSizeSlider" Minimum="160" Maximum="609" StepFrequency="1" ValueChanged="OnSliderChanged" AutomationProperties.Name="Logo 尺寸滑杆" />
                        <NumberBox x:Name="LogoSizeNumber" Grid.Column="1" Minimum="160" Maximum="609" SmallChange="1" ValueChanged="OnNumberChanged" AutomationProperties.Name="Logo 尺寸" />
                    </Grid>

                    <TextBlock Text="水晶强度" />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Slider x:Name="CrystalSlider" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="OnSliderChanged" AutomationProperties.Name="水晶强度滑杆" />
                        <NumberBox x:Name="CrystalNumber" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="OnNumberChanged" AutomationProperties.Name="水晶强度" />
                    </Grid>

                    <TextBlock Text="银色映光强度" />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Slider x:Name="ReflectionSlider" Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="OnSliderChanged" AutomationProperties.Name="银色映光强度滑杆" />
                        <NumberBox x:Name="ReflectionNumber" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="OnNumberChanged" AutomationProperties.Name="银色映光强度" />
                    </Grid>

                    <TextBlock Text="动画时长 (ms)" />
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                        <Slider x:Name="DurationSlider" Minimum="0" Maximum="2000" StepFrequency="10" ValueChanged="OnSliderChanged" AutomationProperties.Name="动画时长滑杆" />
                        <NumberBox x:Name="DurationNumber" Grid.Column="1" Minimum="0" Maximum="2000" SmallChange="10" ValueChanged="OnNumberChanged" AutomationProperties.Name="动画时长" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <InfoBar x:Name="StatusInfo" Grid.Row="2" Margin="20,0,20,20" IsOpen="False" IsClosable="True" />
    </Grid>
</Window>
