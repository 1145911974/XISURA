<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="BackgroundColor">#F7F5FA</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="SurfaceRaisedColor">#EEE9F5</Color>
            <Color x:Key="BrandColor">#6E35D5</Color>
            <Color x:Key="BrandStrongColor">#5C26B9</Color>
            <Color x:Key="DataColor">#006F8E</Color>
            <Color x:Key="TextPrimaryColor">#17121F</Color>
            <Color x:Key="TextSecondaryColor">#554C61</Color>
            <Color x:Key="BorderColor">#C7B9D9</Color>
            <Color x:Key="SuccessColor">#167A4B</Color>
            <Color x:Key="WarningColor">#8A5A00</Color>
            <Color x:Key="DangerColor">#B32642</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BackgroundColor">#0A0710</Color>
            <Color x:Key="SurfaceColor">#14101C</Color>
            <Color x:Key="SurfaceRaisedColor">#1C1627</Color>
            <Color x:Key="BrandColor">#8E55FF</Color>
            <Color x:Key="BrandStrongColor">#B58AFF</Color>
            <Color x:Key="DataColor">#52D6FF</Color>
            <Color x:Key="TextPrimaryColor">#F5F1FF</Color>
            <Color x:Key="TextSecondaryColor">#C7BCD6</Color>
            <Color x:Key="BorderColor">#49336E</Color>
            <Color x:Key="SuccessColor">#57D38C</Color>
            <Color x:Key="WarningColor">#F4BD50</Color>
            <Color x:Key="DangerColor">#FF637D</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DataBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{ThemeResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{ThemeResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{ThemeResource BrandColor}" />
    <SolidColorBrush x:Key="BrandStrongBrush" Color="{ThemeResource BrandStrongColor}" />
    <SolidColorBrush x:Key="DataBrush" Color="{ThemeResource DataColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{ThemeResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource DangerColor}" />
</ResourceDictionary>
