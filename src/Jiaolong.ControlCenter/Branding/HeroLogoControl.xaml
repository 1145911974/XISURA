<UserControl
    x:Class="Jiaolong_ControlCenter.Branding.HeroLogoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AutomationProperties.Name="机械革命蛟龙标志"
    IsHitTestVisible="False"
    mc:Ignorable="d">
    <Viewbox Stretch="Uniform">
        <Grid x:Name="LogoLayers" Width="1254" Height="1254" CacheMode="BitmapCache" UseLayoutRounding="True">
            <Image x:Name="FullLogoOffice" Source="ms-appx:///Assets/Brand/HeroLogoFullOffice.png" Stretch="None" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="FullLogoGaming" Source="ms-appx:///Assets/Brand/HeroLogoFullGaming.png" Stretch="None" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="FullLogoTurbo" Source="ms-appx:///Assets/Brand/HeroLogoFullTurbo.png" Stretch="None" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="FullLogoCustomProfile1" Source="ms-appx:///Assets/Brand/HeroLogoFullCustomProfile1.png" Stretch="None" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="FullLogoCustomProfile2" Source="ms-appx:///Assets/Brand/HeroLogoFullCustomProfile2.png" Stretch="None" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Image x:Name="FullLogoCustomProfile3" Source="ms-appx:///Assets/Brand/HeroLogoFullCustomProfile3.png" Stretch="None" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Grid x:Name="ColorBlendHost" IsHitTestVisible="False" />
            <Grid x:Name="AdaptiveLogoLayers" Opacity="0" IsHitTestVisible="False" CacheMode="BitmapCache">
                <Image x:Name="AdaptiveCoreOffice" Source="ms-appx:///Assets/Brand/HeroLogoFullOffice.png" Stretch="None" Opacity="0.18" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Image x:Name="AdaptiveCoreGaming" Source="ms-appx:///Assets/Brand/HeroLogoFullGaming.png" Stretch="None" Opacity="0.18" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Image x:Name="AdaptiveCoreTurbo" Source="ms-appx:///Assets/Brand/HeroLogoFullTurbo.png" Stretch="None" Opacity="0.18" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Image x:Name="AdaptiveCoreCustomProfile1" Source="ms-appx:///Assets/Brand/HeroLogoFullCustomProfile1.png" Stretch="None" Opacity="0.18" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Image x:Name="AdaptiveCoreCustomProfile2" Source="ms-appx:///Assets/Brand/HeroLogoFullCustomProfile2.png" Stretch="None" Opacity="0.18" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Image x:Name="AdaptiveCoreCustomProfile3" Source="ms-appx:///Assets/Brand/HeroLogoFullCustomProfile3.png" Stretch="None" Opacity="0.18" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                <Image x:Name="AdaptiveSilverShell" Source="ms-appx:///Assets/Brand/HeroLogoSilver.png" Stretch="None" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
